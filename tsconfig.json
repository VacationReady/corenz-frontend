{
  "compilerOptions": {
    "target": "es2015",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    // Disabled for .js scripts and legacy code - migrate or exclude explicitly
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "app/*"
      ],
      "@/components/*": [
        "components/*",
        "app/components/*"
      ],
      "@/lib/*": [
        "lib/*",
        "app/lib/*"
      ],
      "@/types/*": [
        "types/*",
        "app/types/*"
      ],
      "@/hooks/*": [
        "app/hooks/*"
      ]
    },
    "types": [
      "next-auth"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Enhanced strictness flags
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true
    // Deferred for gradual migration - enable file-by-file
    // These flags catch 700+ errors in existing codebase
    // "noUncheckedIndexedAccess": true,
    // "noPropertyAccessFromIndexSignature": true,
    // "noImplicitOverride": true,
    // "noImplicitReturns": true,
    // "exactOptionalPropertyTypes": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "types/**/*.ts",
    "types/**/*.d.ts",
    ".next/types/**/*.ts",
    "types/next-auth.d.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/**/*.js",
    "mobile",
    "prisma/seed.js",
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests/**/*",
    "scripts/debug-employee-user-mapping.ts",
    "scripts/diagnose-org-chart.ts",
    "scripts/fix-broken-manager-ids.ts",
    "scripts/initialize-default-workflows.ts",
    "scripts/test-*.ts",
    "scripts/evaluate-finetune.ts",
    "scripts/check-payroll-data-completeness.ts",
    "lib/payroll/payroll-calculation-service.ts"
  ]
}
