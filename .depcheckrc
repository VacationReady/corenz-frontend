{
  "ignores": [
    "@types/*",
    "autoprefixer",
    "postcss",
    "tailwindcss",
    "eslint*",
    "@typescript-eslint/*",
    "ts-node",
    "tsx",
    "prisma",
    "typescript",
    "preact",
    "ignore-loader",
    "@opentelemetry/api",
    "@opentelemetry/context-async-hooks",
    "@opentelemetry/core",
    "@opentelemetry/sdk-trace-base",
    "@opentelemetry/semantic-conventions",
    "@pdf-lib/standard-fonts"
  ],
  "skip-missing": true
}

