  CreatedByUser      User                  @relation("TemplateVersionCreatedBy", fields: [createdBy], references: [id])
  PublishedByUser    User?                 @relation("TemplateVersionPublishedBy", fields: [publishedBy], references: [id])
  StepVersions       TemplateStepVersion[]

  @@unique([templateId, version])
  @@index([templateId, status])
  @@index([companyId, createdAt])
  @@index([status, publishedAt])
}

