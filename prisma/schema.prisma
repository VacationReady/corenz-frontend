generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivationToken {
  id        String   @id
  token     String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model TenantSwitchToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  companyId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@index([token, expiresAt])
  @@index([companyId])
}

model AutomationExecution {
  id             String                    @id
  ruleId         String
  companyId      String
  triggeredAt    DateTime                  @default(now())
  startedAt      DateTime                  @default(now())
  completedAt    DateTime?
  durationMs     Int?
  status         AutomationExecutionStatus
  triggerData    Json
  executionLog   Json?
  errorMessage   String?
  triggerSummary String?
  contextSnapshot Json?
  lastHeartbeatAt DateTime?
  Company        Company                   @relation(fields: [companyId], references: [id])
  AutomationRule AutomationRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  steps          AutomationExecutionStep[]

  @@index([companyId, status])
  @@index([ruleId, triggeredAt])
}

model AutomationExecutionStep {
  id           String                          @id
  executionId  String
  ruleId       String
  nodeId       String
  nodeType     String
  status       AutomationExecutionStepStatus
  startedAt    DateTime                        @default(now())
  completedAt  DateTime?
  message      String?
  errorMessage String?
  metadata     Json?

  execution    AutomationExecution             @relation(fields: [executionId], references: [id], onDelete: Cascade)
  rule         AutomationRule                  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([executionId, nodeId])
  @@index([ruleId, nodeId])
  @@index([executionId, status])
}

model AutomationJob {
  id             String              @id
  ruleId         String
  companyId      String
  triggerData    Json
  jobType        String?
  jobData        Json?
  status         AutomationJobStatus @default(PENDING)
  priority       Int                 @default(0)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  scheduledAt    DateTime            @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  executionLog   Json?
  nextRetryAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime
  Company        Company             @relation(fields: [companyId], references: [id])
  AutomationRule AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([companyId, status, scheduledAt])
  @@index([ruleId])
  @@index([status, scheduledAt])
}

model AutomationRule {
  id                  String                @id
  companyId           String
  name                String
  description         String?
  isActive            Boolean               @default(false)
  triggerType         AutomationTriggerType
  triggerConfig       Json
  conditions          Json?
  actions             Json
  // Enhanced workflow builder fields
  templateId          String?
  workflowDefinition  Json?
  lastExecutedAt      DateTime?
  executionCount      Int                   @default(0)
  successCount        Int                   @default(0)
  failureCount        Int                   @default(0)
  averageExecutionTime Int?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  createdBy           String
  tags                String[]              @default([])
  version             Int                   @default(1)
  isTemplate          Boolean               @default(false)
  category            String?
  AutomationExecution AutomationExecution[]
  executionSteps      AutomationExecutionStep[]
  AutomationJob       AutomationJob[]
  Company             Company               @relation(fields: [companyId], references: [id])
  User                User                  @relation(fields: [createdBy], references: [id])

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([templateId])
  @@index([category])
}

model BlackoutDay {
  id               String   @id
  date             DateTime
  companyId        String
  allEvents        Boolean  @default(false)
  eventCategoryIds String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  note             String?
}

model BrandingConfiguration {
  id                 String   @id
  companyId          String   @unique
  enabled            Boolean  @default(false)
  logoUrl            String?
  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  emailHeaderEnabled Boolean  @default(false)
  emailFooterEnabled Boolean  @default(false)
  emailFooterText    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  Company            Company  @relation(fields: [companyId], references: [id])
}

model Company {
  id                                  String                                @id
  name                                String                                @unique
  createdAt                           DateTime                              @default(now())
  updatedAt                           DateTime
  address                             String?
  code                                String?                               @unique
  industry                            String?
  phone                               String?
  size                                Int?
  website                             String?
  publicHolidayTemplate               PublicHolidayTemplate?
  publicHolidayRegion                 String?
  ApprovalWorkflow                    ApprovalWorkflow[]
  AutomationExecution                 AutomationExecution[]
  AutomationJob                       AutomationJob[]
  AutomationRule                      AutomationRule[]
  BrandingConfiguration               BrandingConfiguration?
  ContractTypeOption                  ContractTypeOption[]
  Course                              Course[]
  Department                          Department[]
  Document                            Document[]
  Employee                            Employee[]
  EmployeePerformanceReview           EmployeePerformanceReview[]
  EmploymentTypeOption                EmploymentTypeOption[]
  EventCategory                       EventCategory[]
  EventRuleOverride                   EventRuleOverride[]
  EventSubcategory                    EventSubcategory[]
  ExitInterviewFormTemplate           ExitInterviewFormTemplate[]
  ExpiryRule                          ExpiryRule[]
  Form                                Form[]
  GenderOption                        GenderOption[]
  GlobalAuditLog                      GlobalAuditLog[]
  JobRole                             JobRole[]
  LeaveEntitlement                    LeaveEntitlement[]
  LeavePolicy                         LeavePolicy[]
  LeavePolicyAssignment               LeavePolicyAssignment[]
  LeaveRequest                        LeaveRequest[]
  Location                            Location[]
  NewsBookmark                        NewsBookmark[]
  NewsPost                            NewsPost[]
  NewsReaction                        NewsReaction[]
  NotificationChannel                 NotificationChannel[]
  NotificationSettings                NotificationSettings?
  OnboardingTemplate                  OnboardingTemplate[]
  PermissionProfile                   PermissionProfile[]
  SCIMConfiguration                   SCIMConfiguration?
  SSOConfiguration                    SSOConfiguration?
  SavedReport                         SavedReport[]
  ReportSendHistory                   ReportSendHistory[]
  TrainingProvider                    TrainingProvider[]
  Surveys                             Survey[]
  SurveyAutomations                   SurveyAutomation[]
  TransactionalNotificationPreference TransactionalNotificationPreference[]
  TransactionalChangeRequest          TransactionalChangeRequest[]
  User                                User[]
  WorkingPattern                      WorkingPattern[]
  ActionItems                         ActionItem[]              @relation("Company_ActionItem")
  JourneyTemplates                    JourneyTemplate[]
  PersonaProfiles                     PersonaProfile[]
  CompanyObjectives                   CompanyObjective[]
  TenantSwitchTokens                  TenantSwitchToken[]
  RotaGroups                          RotaGroup[]
  OvertimeAuditLogs                   OvertimeAuditLog[]
}

model ContractTypeOption {
  id        String  @id
  companyId String
  label     String
  order     Int     @default(0)
  Company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, label])
  @@index([companyId, order])
}

model Course {
  id             String           @id
  name           String           @unique
  companyId      String?
  Company        Company?         @relation(fields: [companyId], references: [id])
  TrainingRecord TrainingRecord[]
}

model Department {
  id                                 String                        @id
  name                               String
  companyId                          String
  active                             Boolean                       @default(true)
  code                               String?
  createdAt                          DateTime                      @default(now())
  description                        String?
  headId                             String?
  updatedAt                          DateTime
  Company                            Company                       @relation(fields: [companyId], references: [id])
  User_Department_headIdToUser       User?                         @relation("Department_headIdToUser", fields: [headId], references: [id])
  DocumentSignatureDepartment        DocumentSignatureDepartment[]
  DocumentSignatureField             DocumentSignatureField[]
  Employee                           Employee[]
  EventRuleOverride                  EventRuleOverride[]
  User_User_departmentIdToDepartment User[]                        @relation("User_departmentIdToDepartment")
  Document                           Document[]                    @relation("DocumentDepartments")
  OnboardingTemplate                 OnboardingTemplate[]          @relation("OnboardingTemplateDepartments")
  RotaGroups                         RotaGroup[]

  @@unique([companyId, name])
  @@unique([companyId, code])
}

model Document {
  id                        String                        @id
  name                      String
  category                  String?
  path                      String
  size                      Int
  type                      String
  uploaderId                String
  companyId                 String
  createdAt                 DateTime                      @default(now())
  deletedAt                 DateTime?
  url                       String
  employeeId                String?
  description               String?
  canViewAdmin              Boolean                       @default(true)
  canViewEmployee           Boolean                       @default(true)
  canViewManager            Boolean                       @default(false)
  requiresAck               Boolean                       @default(false)
  requireAckFromNewStarters Boolean                       @default(false)
  requiresSignature         Boolean                       @default(false)
  signatureDueAt            DateTime?
  Company                   Company                       @relation(fields: [companyId], references: [id])
  Employee                  Employee?                     @relation(fields: [employeeId], references: [id])
  User                      User                          @relation(fields: [uploaderId], references: [id])
  DocumentAcknowledgement   DocumentAcknowledgement[]
  SignatureArtifacts        DocumentSignatureArtifact[]
  SignatureDepartments      DocumentSignatureDepartment[]
  SignatureEmployees        DocumentSignatureEmployee[]
  SignatureFields           DocumentSignatureField[]
  SignatureJobRoles         DocumentSignatureJobRole[]
  DriverLicence             DriverLicence[]
  OnboardingStep            OnboardingStep[]
  TrainingRecord            TrainingRecord[]
  Department                Department[]                  @relation("DocumentDepartments")
  JobRole                   JobRole[]                     @relation("DocumentJobRoles")
}

model DocumentSignatureArtifact {
  id           String          @id
  documentId   String
  employeeId   String
  method       SignatureMethod
  typedText    String?
  artifactPath String?
  signedAt     DateTime        @default(now())
  ipAddress    String?
  userAgent    String?
  Document     Document        @relation(fields: [documentId], references: [id])
  Employee     Employee        @relation(fields: [employeeId], references: [id])

  @@unique([documentId, employeeId])
}

model DocumentSignatureDepartment {
  documentId   String
  departmentId String
  Department   Department @relation(fields: [departmentId], references: [id])
  Document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, departmentId])
}

model DocumentSignatureJobRole {
  documentId String
  jobRoleId  String
  Document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  JobRole    JobRole  @relation(fields: [jobRoleId], references: [id])

  @@id([documentId, jobRoleId])
}

model DocumentSignatureEmployee {
  documentId String
  employeeId String
  dueAt      DateTime?
  Document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  Employee   Employee  @relation(fields: [employeeId], references: [id])

  @@id([documentId, employeeId])
}

model DocumentSignatureField {
  id                   String      @id
  documentId           String
  pageNumber           Int         @default(1)
  x                    Float
  y                    Float
  width                Float
  height               Float
  label                String?
  required             Boolean     @default(true)
  assignedEmployeeId   String?
  assignedDepartmentId String?
  assignedJobRoleId    String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  Department           Department? @relation(fields: [assignedDepartmentId], references: [id])
  Employee             Employee?   @relation(fields: [assignedEmployeeId], references: [id])
  JobRole              JobRole?    @relation(fields: [assignedJobRoleId], references: [id])
  Document             Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentAcknowledgement {
  id                String           @id
  documentId        String
  employeeId        String
  acknowledgedAt    DateTime         @default(now())
  employmentCheckId String?
  Document          Document         @relation(fields: [documentId], references: [id])
  Employee          Employee         @relation(fields: [employeeId], references: [id])
  EmploymentCheck   EmploymentCheck? @relation(fields: [employmentCheckId], references: [id])

  @@unique([documentId, employeeId])
}

model DriverLicence {
  id            String    @id
  employeeId    String
  type          String
  licenceNumber String
  issueDate     DateTime
  expiryDate    DateTime
  documentId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Document      Document? @relation(fields: [documentId], references: [id])
  Employee      Employee  @relation(fields: [employeeId], references: [id])
}

model EmergencyContact {
  id           String   @id
  employeeId   String
  name         String
  relationship String?
  phone        String?
  email        String?
  Employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Employee {
  id                               String                             @id
  userId                           String                             @unique
  isActive                         Boolean                            @default(true)
  workingPatternId                 String?
  departmentId                     String?
  jobRoleId                        String?
  onboardingStatus                 Json?
  onboardingTemplateId             String?
  companyId                        String
  offboardingStatus                String?
  offboardingDate                  DateTime?
  lastWorkingDate                  DateTime?
  noticePeriodDays                 Int?
  offboardingReason                String?
  offboardingNotes                 String?
  locationId                       String?
  startDate                        DateTime?
  contractEndDate                  DateTime?
  bankAccountNumber                String?
  contractType                     String?
  employmentType                   String?
  hourlyRate                       Decimal?                           @db.Decimal(10, 2)
  kiwiSaverContribution            Int?
  kiwiSaverEnrolled                Boolean?
  salaryAmount                     Decimal?                           @db.Decimal(10, 2)
  siteLocation                     String?
  irdNumber                        String?
  taxCode                          TaxCode?
  // Overtime configuration (NZ Employment Relations Act 2000 compliance)
  overtimeEligible                 Boolean                            @default(true)
  overtimeThreshold                Decimal?                           @db.Decimal(5, 2) // Override company default
  overtimeMultiplier               Decimal?                           @db.Decimal(3, 2) // Override company default
  overtimeCalculationMode          String?                            // Override company mode
  maxOvertimeHoursPerWeek          Decimal?                           @db.Decimal(4, 2) // Safety/compliance cap
  Document                         Document[]
  DocumentAcknowledgement          DocumentAcknowledgement[]
  DocumentSignatureArtifact        DocumentSignatureArtifact[]
  DocumentSignatureEmployee        DocumentSignatureEmployee[]
  DocumentSignatureField           DocumentSignatureField[]
  DriverLicence                    DriverLicence[]
  EmergencyContact                 EmergencyContact[]
  Company                          Company                            @relation(fields: [companyId], references: [id])
  Department                       Department?                        @relation(fields: [departmentId], references: [id])
  JobRole                          JobRole?                           @relation(fields: [jobRoleId], references: [id])
  Location                         Location?                          @relation(fields: [locationId], references: [id])
  OnboardingTemplate               OnboardingTemplate?                @relation(fields: [onboardingTemplateId], references: [id])
  User                             User                               @relation(fields: [userId], references: [id])
  WorkingPattern                   WorkingPattern?                    @relation(fields: [workingPatternId], references: [id])
  EmployeeAuditLog                 EmployeeAuditLog[]
  EmployeeOffboarding              EmployeeOffboarding?
  PerformanceReviews               EmployeePerformanceReview[]
  EmployeeWorkingPatternAssignment EmployeeWorkingPatternAssignment[]
  EmploymentCheck                  EmploymentCheck[]
  FormAssignment                   FormAssignment[]
  FormDataRecord                   FormDataRecord[]
  FormSubmission                   FormSubmission[]
  SurveyRecipients                 SurveyRecipient[]
  SurveyResponses                  SurveyResponse[]
  LeaveEntitlement                 LeaveEntitlement[]
  LeaveRequest                     LeaveRequest[]
  OnboardingInstance               OnboardingInstance[]
  TrainingRecord                   TrainingRecord[]
  TransactionalChangeRequest       TransactionalChangeRequest[]
  ActionItems                      ActionItem[]                   @relation("Employee_ActionItem_Related")
  JourneyInstances                 JourneyInstance[]
  PushNotificationTokens           PushNotificationToken[]
  Timesheets                       Timesheet[]                        @relation("TimesheetEmployee")
  ApprovedTimesheets               Timesheet[]                        @relation("TimesheetApprovedByEmployee")
  ClockEntries                     ClockEntry[]                       @relation("ClockEntryEmployee")
  Shifts                           Shift[]                            @relation("ShiftEmployee")
  RotaGroupMemberships             RotaGroupMember[]                  @relation("RotaGroupMembers")
  TimesheetEntryAuditsAsEmployee   TimesheetEntryAudit[]              @relation("TimesheetEntryAuditEmployee")
  TimesheetEntryAuditsAsChanger    TimesheetEntryAudit[]              @relation("TimesheetEntryAuditChangedBy")
  OvertimeAuditLogs                OvertimeAuditLog[]

  @@unique([companyId, irdNumber])
}

model EmployeePerformanceReview {
  id                  String             @id
  employeeId          String
  companyId           String
  reviewerId          String?
  reviewType          PerformanceReviewType @default(MANAGER_REVIEW)
  isAnonymous         Boolean            @default(false)
  reviewDate          DateTime
  rating              Int?
  summary             String?
  strengths           String?
  areasForImprovement String?
  goals               Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  Company             Company  @relation(fields: [companyId], references: [id])
  Employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Reviewer            User?    @relation("EmployeePerformanceReviewReviewer", fields: [reviewerId], references: [id])

  @@index([employeeId, reviewDate])
  @@index([companyId])
  @@index([reviewType, isAnonymous])
}

model EmployeeOffboarding {
  id                                                 String                        @id
  employeeId                                         String                        @unique
  initiatedById                                      String
  initiatedAt                                        DateTime                      @default(now())
  completedAt                                        DateTime?
  resignationDate                                    DateTime?
  lastWorkingDate                                    DateTime
  noticePeriodDays                                   Int?
  actualLeaveDate                                    DateTime?
  offboardingReason                                  String?
  isVoluntary                                        Boolean                       @default(true)
  removeAccessImmediately                            Boolean                       @default(false)
  accessRemovedAt                                    DateTime?
  accessRemovedBy                                    String?
  assetsToReturn                                     Json?
  assetsReturned                                     Boolean                       @default(false)
  assetsReturnedAt                                   DateTime?
  assetsReturnedTo                                   String?
  handoverRequired                                   Boolean                       @default(false)
  handoverAssignedTo                                 String?
  handoverCompleted                                  Boolean                       @default(false)
  handoverCompletedAt                                DateTime?
  handoverNotes                                      String?
  finalPayCalculated                                 Boolean                       @default(false)
  finalPayAmount                                     Decimal?                      @db.Decimal(10, 2)
  unusedLeaveHours                                   Decimal?                      @db.Decimal(8, 2)
  unusedLeavePayment                                 Decimal?                      @db.Decimal(10, 2)
  benefitsEndDate                                    DateTime?
  exitInterviewRequired                              Boolean                       @default(false)
  exitInterviewScheduled                             Boolean                       @default(false)
  exitInterviewNotes                                 String?
  hrReviewRequired                                   Boolean                       @default(true)
  hrReviewCompleted                                  Boolean                       @default(false)
  hrReviewCompletedBy                                String?
  hrReviewCompletedAt                                DateTime?
  hrNotes                                            String?
  referenceContactAllowed                            Boolean                       @default(true)
  documentationArchived                              Boolean                       @default(false)
  complianceCheckCompleted                           Boolean                       @default(false)
  createdAt                                          DateTime                      @default(now())
  updatedAt                                          DateTime
  exitInterviewDate                                  DateTime?
  exitInterviewEnd                                   DateTime?
  interviewerUserId                                  String?
  interviewerName                                    String?
  interviewerEmail                                   String?
  location                                           String?
  sendForm                                           Boolean                       @default(false)
  formTemplateId                                     String?
  inviteIcsUid                                       String?
  inviteLastSentAt                                   DateTime?
  scheduledSendAt                                    DateTime?
  completionTokenHash                                String?
  status                                             OffboardingStatus             @default(IN_PROGRESS)
  offboardingType                                    OffboardingType
  formTiming                                         ExitInterviewFormTiming?
  completionStatus                                   ExitInterviewCompletionStatus @default(PENDING)
  User_EmployeeOffboarding_accessRemovedByToUser     User?                         @relation("EmployeeOffboarding_accessRemovedByToUser", fields: [accessRemovedBy], references: [id])
  User_EmployeeOffboarding_assetsReturnedToToUser    User?                         @relation("EmployeeOffboarding_assetsReturnedToToUser", fields: [assetsReturnedTo], references: [id])
  Employee                                           Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ExitInterviewFormTemplate                          ExitInterviewFormTemplate?    @relation(fields: [formTemplateId], references: [id])
  User_EmployeeOffboarding_handoverAssignedToToUser  User?                         @relation("EmployeeOffboarding_handoverAssignedToToUser", fields: [handoverAssignedTo], references: [id])
  User_EmployeeOffboarding_hrReviewCompletedByToUser User?                         @relation("EmployeeOffboarding_hrReviewCompletedByToUser", fields: [hrReviewCompletedBy], references: [id])
  User_EmployeeOffboarding_initiatedByIdToUser       User                          @relation("EmployeeOffboarding_initiatedByIdToUser", fields: [initiatedById], references: [id])
  User_EmployeeOffboarding_interviewerUserIdToUser   User?                         @relation("EmployeeOffboarding_interviewerUserIdToUser", fields: [interviewerUserId], references: [id])
  ExitInterview                                      ExitInterview?
  ExitInterviewSubmission                            ExitInterviewSubmission[]
  OffboardingTask                                    OffboardingTask[]

  @@index([employeeId])
  @@index([exitInterviewDate])
  @@index([lastWorkingDate])
  @@index([scheduledSendAt])
  @@index([status])
}

model EmployeeWorkingPatternAssignment {
  id               String         @id
  employeeId       String
  workingPatternId String
  effectiveDate    DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  Employee         Employee       @relation(fields: [employeeId], references: [id])
  WorkingPattern   WorkingPattern @relation(fields: [workingPatternId], references: [id])

  @@index([employeeId, effectiveDate])
}

model EmploymentCheck {
  id                      String                    @id
  employeeId              String
  typeOfCheck             String
  documentNumber          String
  dateOfIssue             DateTime
  expiryDate              DateTime
  documentUrl             String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  DocumentAcknowledgement DocumentAcknowledgement[]
  Employee                Employee                  @relation(fields: [employeeId], references: [id])
}

model EmploymentTypeOption {
  id        String  @id
  companyId String
  label     String
  order     Int     @default(0)
  Company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, label])
  @@index([companyId, order])
}

model EventCategory {
  id                String              @id
  name              String
  requiresApproval  Boolean
  adminOnly         Boolean
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  categoryType      String
  color             String?
  systemDefined     Boolean             @default(false)
  companyId         String
  ApprovalWorkflow  ApprovalWorkflow[]
  Company           Company             @relation(fields: [companyId], references: [id])
  EventRule         EventRule[]
  EventRuleOverride EventRuleOverride[]
  EventSubcategory  EventSubcategory[]
  LeaveEntitlement  LeaveEntitlement[]
  LeavePolicy       LeavePolicy[]
  LeaveRequest      LeaveRequest[]

  @@unique([companyId, name])
}

model EventRule {
  id                    String          @id
  companyId             String
  eventCategoryId       String
  enforceEntitlement    Boolean         @default(true)
  noticePeriodDays      Int             @default(0)
  maxConcurrent         Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime
  maxBookingLength      Int?
  maxCarryoverDays      Int?
  carryoverExpiryMonths Int?
  maxBookingLengthMode  EnforcementMode @default(HARD_BLOCK)
  maxConcurrentMode     EnforcementMode @default(HARD_BLOCK)
  notes                 String?
  EventCategory         EventCategory   @relation(fields: [eventCategoryId], references: [id])

  @@unique([companyId, eventCategoryId])
}

model EventRuleOverride {
  id                       String                  @id
  companyId                String
  eventCategoryId          String
  departmentId             String?
  teamId                   String?
  enforceEntitlement       Boolean?
  noticePeriodDays         Int?
  maxConcurrent            Int?
  maxBookingLength         Int?
  maxConcurrentMode        EnforcementMode?
  maxBookingLengthMode     EnforcementMode?
  staffingDensityEnabled   Boolean                 @default(false)
  staffingDensityThreshold Float?
  staffingDensityBehavior  StaffingDensityBehavior @default(DENY)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime
  Company                  Company                 @relation(fields: [companyId], references: [id])
  Department               Department?             @relation(fields: [departmentId], references: [id])
  EventCategory            EventCategory           @relation(fields: [eventCategoryId], references: [id])

  @@unique([companyId, eventCategoryId, departmentId, teamId])
  @@index([companyId, eventCategoryId])
}

model EventSubcategory {
  id                String         @id
  name              String
  eventCategoryId   String
  defaultPaidStatus PaidStatus     @default(PAID)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  companyId         String
  Company           Company        @relation(fields: [companyId], references: [id])
  EventCategory     EventCategory  @relation(fields: [eventCategoryId], references: [id])
  LeaveRequest      LeaveRequest[]

  @@unique([companyId, name])
}

model ExitInterview {
  id                  String              @id
  offboardingId       String              @unique
  scheduledAt         DateTime?
  interviewerId       String?
  location            String?
  notes               String?
  completed           Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  EmployeeOffboarding EmployeeOffboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)

  @@index([offboardingId])
}

model ExitInterviewFormTemplate {
  id                      String                    @id
  name                    String
  description             String?
  schemaJson              Json
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  companyId               String?
  EmployeeOffboarding     EmployeeOffboarding[]
  Company                 Company?                  @relation(fields: [companyId], references: [id])
  ExitInterviewSubmission ExitInterviewSubmission[]

  @@index([isActive])
}

model ExitInterviewSubmission {
  id                        String                    @id
  offboardingId             String
  templateId                String
  submittedBy               String?
  submittedAt               DateTime?
  answersJson               Json?
  EmployeeOffboarding       EmployeeOffboarding       @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  ExitInterviewFormTemplate ExitInterviewFormTemplate @relation(fields: [templateId], references: [id])

  @@index([offboardingId])
  @@index([templateId])
}

model ExpiryRule {
  id             String   @id
  category       String   @unique
  daysBefore     Int
