generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivationToken {
  id        String   @id
  token     String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model TenantSwitchToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  companyId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  User    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  Company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([token, expiresAt])
  @@index([companyId])
}

model AutomationExecution {
  id              String                    @id
  ruleId          String
  companyId       String
  triggeredAt     DateTime                  @default(now())
  startedAt       DateTime                  @default(now())
  completedAt     DateTime?
  durationMs      Int?
  status          AutomationExecutionStatus
  triggerData     Json
  executionLog    Json?
  errorMessage    String?
  triggerSummary  String?
  contextSnapshot Json?
  lastHeartbeatAt DateTime?
  Company         Company                   @relation(fields: [companyId], references: [id])
  AutomationRule  AutomationRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  steps           AutomationExecutionStep[]

  @@index([companyId, status])
  @@index([ruleId, triggeredAt])
}

model AutomationExecutionStep {
  id           String                        @id
  executionId  String
  ruleId       String
  nodeId       String
  nodeType     String
  status       AutomationExecutionStepStatus
  startedAt    DateTime                      @default(now())
  completedAt  DateTime?
  message      String?
  errorMessage String?
  metadata     Json?

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  rule      AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([executionId, nodeId])
  @@index([ruleId, nodeId])
  @@index([executionId, status])
}

model AutomationJob {
  id             String              @id
  ruleId         String
  companyId      String
  triggerData    Json
  jobType        String?
  jobData        Json?
  status         AutomationJobStatus @default(PENDING)
  priority       Int                 @default(0)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  scheduledAt    DateTime            @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  executionLog   Json?
  nextRetryAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime
  Company        Company             @relation(fields: [companyId], references: [id])
  AutomationRule AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([companyId, status, scheduledAt])
  @@index([ruleId])
  @@index([status, scheduledAt])
}

model AutomationRule {
  id                   String                    @id
  companyId            String
  name                 String
  description          String?
  isActive             Boolean                   @default(false)
  triggerType          AutomationTriggerType
  triggerConfig        Json
  conditions           Json?
  actions              Json
  // Enhanced workflow builder fields
  templateId           String?
  workflowDefinition   Json?
  lastExecutedAt       DateTime?
  executionCount       Int                       @default(0)
  successCount         Int                       @default(0)
  failureCount         Int                       @default(0)
  averageExecutionTime Int?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime
  createdBy            String
  tags                 String[]                  @default([])
  version              Int                       @default(1)
  isTemplate           Boolean                   @default(false)
  category             String?
  AutomationExecution  AutomationExecution[]
  executionSteps       AutomationExecutionStep[]
  AutomationJob        AutomationJob[]
  Company              Company                   @relation(fields: [companyId], references: [id])
  User                 User                      @relation(fields: [createdBy], references: [id])

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([templateId])
  @@index([category])
}

model BlackoutDay {
  id               String   @id
  date             DateTime
  companyId        String
  allEvents        Boolean  @default(false)
  eventCategoryIds String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  note             String?
}

model BrandingConfiguration {
  id                 String   @id
  companyId          String   @unique
  enabled            Boolean  @default(false)
  logoUrl            String?
  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  emailHeaderEnabled Boolean  @default(false)
  emailFooterEnabled Boolean  @default(false)
  emailFooterText    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  Company            Company  @relation(fields: [companyId], references: [id])
}

model Company {
  id                                  String                                @id
  name                                String                                @unique
  createdAt                           DateTime                              @default(now())
  updatedAt                           DateTime
  address                             String?
  code                                String?                               @unique
  industry                            String?
  phone                               String?
  size                                Int?
  website                             String?
  publicHolidayTemplate               PublicHolidayTemplate?
  publicHolidayRegion                 String?
  // Calendar visibility settings
  calendarEmployeeScope               CalendarEmployeeScope                 @default(DEPARTMENT)
  // Custom document categories (JSON array of strings)
  documentCategories                  Json?
  ApprovalWorkflow                    ApprovalWorkflow[]
  AutomationExecution                 AutomationExecution[]
  AutomationJob                       AutomationJob[]
  AutomationRule                      AutomationRule[]
  BrandingConfiguration               BrandingConfiguration?
  ContractTypeOption                  ContractTypeOption[]
  Course                              Course[]
  Department                          Department[]
  Document                            Document[]
  Employee                            Employee[]
  EmployeePerformanceReview           EmployeePerformanceReview[]
  EmploymentTypeOption                EmploymentTypeOption[]
  EventCategory                       EventCategory[]
  EventRuleOverride                   EventRuleOverride[]
  EventSubcategory                    EventSubcategory[]
  ExitInterviewFormTemplate           ExitInterviewFormTemplate[]
  ExpiryNotificationLog               ExpiryNotificationLog[]
  ExpiryRule                          ExpiryRule[]
  Form                                Form[]
  GenderOption                        GenderOption[]
  GlobalAuditLog                      GlobalAuditLog[]
  JobRole                             JobRole[]
  LeaveEntitlement                    LeaveEntitlement[]
  LeavePolicy                         LeavePolicy[]
  LeavePolicyAssignment               LeavePolicyAssignment[]
  LeaveRequest                        LeaveRequest[]
  Location                            Location[]
  NewsBookmark                        NewsBookmark[]
  NewsEmailJob                        NewsEmailJob[]
  NewsPost                            NewsPost[]
  NewsReaction                        NewsReaction[]
  NewsRead                            NewsRead[]
  NotificationChannel                 NotificationChannel[]
  NotificationSettings                NotificationSettings?
  OnboardingTemplate                  OnboardingTemplate[]
  OnboardingTemplateTelemetryEvent    OnboardingTemplateTelemetryEvent[]
  PermissionProfile                   PermissionProfile[]
  SCIMConfiguration                   SCIMConfiguration?
  SSOConfiguration                    SSOConfiguration?
  SavedReport                         SavedReport[]
  ReportSendHistory                   ReportSendHistory[]
  ReportFilterPreset                  ReportFilterPreset[]
  ReportSchedule                      ReportSchedule[]
  ReportShare                         ReportShare[]
  TrainingProvider                    TrainingProvider[]
  Surveys                             Survey[]
  SurveyAutomations                   SurveyAutomation[]
  TransactionalNotificationPreference TransactionalNotificationPreference[]
  TransactionalChangeRequest          TransactionalChangeRequest[]
  User                                User[]
  WorkingPattern                      WorkingPattern[]
  ActionItems                         ActionItem[]                          @relation("Company_ActionItem")
  JourneyTemplates                    JourneyTemplate[]
  PersonaProfiles                     PersonaProfile[]
  CompanyObjectives                   CompanyObjective[]
  TenantSwitchTokens                  TenantSwitchToken[]
  RotaGroups                          RotaGroup[]
  OvertimeAuditLogs                   OvertimeAuditLog[]
  PayrollCalculations                 PayrollCalculation[]
  OnboardingStepAuditLogs             OnboardingStepAuditLog[]
  OnboardingReminders                 OnboardingReminder[]
  EmployeeOtherEntitlements           EmployeeOtherEntitlement[]
  XeroIntegration                     XeroIntegration?
  TenantFeatureToggles                TenantFeatureToggle[]
  BugReport                           BugReport[]
}

model TenantFeatureToggle {
  id         String   @id @default(cuid())
  companyId  String
  featureKey String
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  Company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureKey])
  @@index([companyId])
}

model ContractTypeOption {
  id        String  @id
  companyId String
  label     String
  order     Int     @default(0)
  Company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, label])
  @@index([companyId, order])
}

model Course {
  id             String           @id
  name           String           @unique
  companyId      String?
  Company        Company?         @relation(fields: [companyId], references: [id])
  TrainingRecord TrainingRecord[]
}

model Department {
  id                                 String                        @id
  name                               String
  companyId                          String
  active                             Boolean                       @default(true)
  code                               String?
  createdAt                          DateTime                      @default(now())
  description                        String?
  headId                             String?
  updatedAt                          DateTime
  Company                            Company                       @relation(fields: [companyId], references: [id])
  User_Department_headIdToUser       User?                         @relation("Department_headIdToUser", fields: [headId], references: [id])
  DocumentSignatureDepartment        DocumentSignatureDepartment[]
  DocumentSignatureField             DocumentSignatureField[]
  Employee                           Employee[]
  EventRuleOverride                  EventRuleOverride[]
  User_User_departmentIdToDepartment User[]                        @relation("User_departmentIdToDepartment")
  Document                           Document[]                    @relation("DocumentDepartments")
  OnboardingTemplate                 OnboardingTemplate[]          @relation("OnboardingTemplateDepartments")
  RotaGroups                         RotaGroup[]
  ReportShare                        ReportShare[]
  JobRole                            JobRole[]

  @@unique([companyId, name])
  @@unique([companyId, code])
}

model Document {
  id                        String                        @id
  name                      String
  category                  String?
  path                      String
  size                      Int
  type                      String
  uploaderId                String
  companyId                 String
  createdAt                 DateTime                      @default(now())
  deletedAt                 DateTime?
  url                       String
  employeeId                String?
  description               String?
  canViewAdmin              Boolean                       @default(true)
  canViewEmployee           Boolean                       @default(true)
  canViewManager            Boolean                       @default(false)
  requiresAck               Boolean                       @default(false)
  requireAckFromNewStarters Boolean                       @default(false)
  requiresSignature         Boolean                       @default(false)
  signatureDueAt            DateTime?
  Company                   Company                       @relation(fields: [companyId], references: [id])
  Employee                  Employee?                     @relation(fields: [employeeId], references: [id])
  User                      User                          @relation(fields: [uploaderId], references: [id])
  DocumentAcknowledgement   DocumentAcknowledgement[]
  SignatureArtifacts        DocumentSignatureArtifact[]
  SignatureDepartments      DocumentSignatureDepartment[]
  SignatureEmployees        DocumentSignatureEmployee[]
  SignatureFields           DocumentSignatureField[]
  SignatureJobRoles         DocumentSignatureJobRole[]
  DriverLicence             DriverLicence[]
  OnboardingStep            OnboardingStep[]
  TrainingRecord            TrainingRecord[]
  Department                Department[]                  @relation("DocumentDepartments")
  JobRole                   JobRole[]                     @relation("DocumentJobRoles")
}

model DocumentSignatureArtifact {
  id           String          @id
  documentId   String
  employeeId   String
  method       SignatureMethod
  typedText    String?
  artifactPath String?
  signedAt     DateTime        @default(now())
  ipAddress    String?
  userAgent    String?
  Document     Document        @relation(fields: [documentId], references: [id])
  Employee     Employee        @relation(fields: [employeeId], references: [id])

  @@unique([documentId, employeeId])
}

model DocumentSignatureDepartment {
  documentId   String
  departmentId String
  Department   Department @relation(fields: [departmentId], references: [id])
  Document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, departmentId])
}

model DocumentSignatureJobRole {
  documentId String
  jobRoleId  String
  Document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  JobRole    JobRole  @relation(fields: [jobRoleId], references: [id])

  @@id([documentId, jobRoleId])
}

model DocumentSignatureEmployee {
  documentId String
  employeeId String
  dueAt      DateTime?
  Document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  Employee   Employee  @relation(fields: [employeeId], references: [id])

  @@id([documentId, employeeId])
}

model DocumentSignatureField {
  id                   String      @id
  documentId           String
  pageNumber           Int         @default(1)
  x                    Float
  y                    Float
  width                Float
  height               Float
  label                String?
  required             Boolean     @default(true)
  assignedEmployeeId   String?
  assignedDepartmentId String?
  assignedJobRoleId    String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  Department           Department? @relation(fields: [assignedDepartmentId], references: [id])
  Employee             Employee?   @relation(fields: [assignedEmployeeId], references: [id])
  JobRole              JobRole?    @relation(fields: [assignedJobRoleId], references: [id])
  Document             Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentAcknowledgement {
  id                String           @id
  documentId        String
  employeeId        String
  acknowledgedAt    DateTime         @default(now())
  employmentCheckId String?
  Document          Document         @relation(fields: [documentId], references: [id])
  Employee          Employee         @relation(fields: [employeeId], references: [id])
  EmploymentCheck   EmploymentCheck? @relation(fields: [employmentCheckId], references: [id])

  @@unique([documentId, employeeId])
}

model DriverLicence {
  id            String    @id
  employeeId    String
  type          String
  licenceNumber String
  issueDate     DateTime
  expiryDate    DateTime
  documentId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Document      Document? @relation(fields: [documentId], references: [id])
  Employee      Employee  @relation(fields: [employeeId], references: [id])
}

model EmergencyContact {
  id           String   @id
  employeeId   String
  name         String
  relationship String?
  phone        String?
  email        String?
  Employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Employee {
  id                               String                             @id
  userId                           String                             @unique
  isActive                         Boolean                            @default(true)
  workingPatternId                 String?
  departmentId                     String?
  jobRoleId                        String?
  onboardingStatus                 Json?
  onboardingTemplateId             String?
  companyId                        String
  offboardingStatus                String?
  offboardingDate                  DateTime?
  lastWorkingDate                  DateTime?
  noticePeriodDays                 Int?
  offboardingReason                String?
  offboardingNotes                 String?
  locationId                       String?
  startDate                        DateTime?
  contractEndDate                  DateTime?
  bankAccountNumber                String?
  contractType                     String?
  employmentType                   String?
  hourlyRate                       Decimal?                           @db.Decimal(10, 2)
  kiwiSaverContribution            Int?
  kiwiSaverEnrolled                Boolean?
  salaryAmount                     Decimal?                           @db.Decimal(10, 2)
  siteLocation                     String?
  irdNumber                        String?
  taxCode                          TaxCode?
  role                             Role                               @default(EMPLOYEE)
  // Overtime configuration (NZ Employment Relations Act 2000 compliance)
  overtimeEligible                 Boolean                            @default(true)
  overtimeThreshold                Decimal?                           @db.Decimal(5, 2) // Override company default
  overtimeMultiplier               Decimal?                           @db.Decimal(3, 2) // Override company default
  overtimeCalculationMode          String? // Override company mode
  maxOvertimeHoursPerWeek          Decimal?                           @db.Decimal(4, 2) // Safety/compliance cap
  // Payroll & Tax Fields (Tax Administration Act 1994)
  dateOfBirth                      DateTime?
  studentLoanBalance               Decimal?                           @db.Decimal(10, 2)
  hasStudentLoan                   Boolean                            @default(false)
  studentLoanRate                  Decimal?                           @default(0.12) @db.Decimal(4, 2) // 12% standard rate
  kiwiSaverEmployeeRate            Decimal?                           @db.Decimal(4, 2) // 0.03, 0.04, 0.06, 0.08, 0.10
  kiwiSaverEmployerRate            Decimal?                           @default(0.03) @db.Decimal(4, 2)
  esctRate                         Decimal?                           @db.Decimal(4, 2) // 0.105, 0.175, 0.28, 0.33
  specialTaxRate                   Decimal?                           @db.Decimal(5, 4) // For non-standard tax situations
  taxExemptionReason               String? // Reason if tax exempt or special rate
  // Leave Balances (Holidays Act 2003)
  annualLeaveBalance               Decimal                            @default(0) @db.Decimal(8, 2)
  /// Sick leave balance in HOURS. This is a CACHE - source of truth is LeaveBalanceLedger.
  /// Updated exclusively via lib/leave/nz-sick-leave-ledger.ts helper functions.
  /// DO NOT write directly to this field outside the ledger helper.
  sickLeaveBalance                 Decimal                            @default(0) @db.Decimal(8, 2)
  alternativeDaysBalance           Int                                @default(0)
  annualLeaveAccrualRate           Decimal?                           @default(0.08) @db.Decimal(4, 2)
  sickLeaveEntitlement             Decimal?                           @default(80) @db.Decimal(4, 1)
  employmentStartDate              DateTime?
  // NZ Sick Leave Eligibility & Grant Tracking (Holidays Act 2003)
  /// Date employee becomes eligible for sick leave (6 months after employment start)
  sickLeaveEligibilityDate         DateTime?
  /// Date of last sick leave grant (used to calculate next anniversary grant)
  sickLeaveLastGrantDate           DateTime?
  // NZ Leave Compliance Fields (Holidays Act 2003 - Annual Leave, Sick Leave, Alternative Holidays)
  sickLeaveDaysPerYear             Decimal?                           @default(10) @db.Decimal(4, 1) // NZ minimum: 10 days after 6 months
  alternativeHolidayBalance        Decimal?                           @default(0) @db.Decimal(5, 1) // Earned when working public holidays
  publicHolidaysPerYear            Int?                               @default(11) // NZ: 11 national + regional holidays
  canBookPublicHolidays            Boolean                            @default(false) // Allow employee to book leave on public holidays (e.g., contractors)
  // Audit Fields
  taxCodeLastUpdated               DateTime?
  kiwiSaverLastUpdated             DateTime?
  leaveBalanceLastUpdated          DateTime?
  // Visa & Work Permit (Immigration Act 2009)
  visaExpiryDate                   DateTime?
  workPermitType                   String?
  // Trial Period (Employment Relations Act 2000 - 90-day trial)
  ninetyDayTrialPeriod             Boolean                            @default(false)
  trialPeriodEndDate               DateTime?
  trialPeriodAccepted              Boolean                            @default(false)
  trialPeriodAcceptedAt            DateTime?
  trialNotifyRecipient             String? // MANAGER, ADMIN, or BOTH
  trialNotifyDaysBefore            Int? // Days before trial end to send reminder
  trialNotificationSent            Boolean                            @default(false)
  Document                         Document[]
  DocumentAcknowledgement          DocumentAcknowledgement[]
  DocumentSignatureArtifact        DocumentSignatureArtifact[]
  DocumentSignatureEmployee        DocumentSignatureEmployee[]
  DocumentSignatureField           DocumentSignatureField[]
  DriverLicence                    DriverLicence[]
  EmergencyContact                 EmergencyContact[]
  Company                          Company                            @relation(fields: [companyId], references: [id])
  Department                       Department?                        @relation(fields: [departmentId], references: [id])
  JobRole                          JobRole?                           @relation(fields: [jobRoleId], references: [id])
  Location                         Location?                          @relation(fields: [locationId], references: [id])
  OnboardingTemplate               OnboardingTemplate?                @relation(fields: [onboardingTemplateId], references: [id])
  User                             User                               @relation(fields: [userId], references: [id])
  WorkingPattern                   WorkingPattern?                    @relation(fields: [workingPatternId], references: [id])
  EmployeeAuditLog                 EmployeeAuditLog[]
  EmployeeOffboarding              EmployeeOffboarding?
  PerformanceReviews               EmployeePerformanceReview[]
  EmployeeWorkingPatternAssignment EmployeeWorkingPatternAssignment[]
  EmploymentCheck                  EmploymentCheck[]
  ExpiryNotificationLog            ExpiryNotificationLog[]
  FormAssignment                   FormAssignment[]
  FormDataRecord                   FormDataRecord[]
  FormSubmission                   FormSubmission[]
  SurveyRecipients                 SurveyRecipient[]
  SurveyResponses                  SurveyResponse[]
  LeaveEntitlement                 LeaveEntitlement[]
  LeaveRequest                     LeaveRequest[]
  OnboardingInstance               OnboardingInstance[]
  TrainingRecord                   TrainingRecord[]
  TransactionalChangeRequest       TransactionalChangeRequest[]
  ActionItems                      ActionItem[]                       @relation("Employee_ActionItem_Related")
  JourneyInstances                 JourneyInstance[]
  PushNotificationTokens           PushNotificationToken[]
  Timesheets                       Timesheet[]                        @relation("TimesheetEmployee")
  ApprovedTimesheets               Timesheet[]                        @relation("TimesheetApprovedByEmployee")
  ClockEntries                     ClockEntry[]                       @relation("ClockEntryEmployee")
  Shifts                           Shift[]                            @relation("ShiftEmployee")
  RotaGroupMemberships             RotaGroupMember[]                  @relation("RotaGroupMembers")
  TimesheetEntryAuditsAsEmployee   TimesheetEntryAudit[]              @relation("TimesheetEntryAuditEmployee")
  TimesheetEntryAuditsAsChanger    TimesheetEntryAudit[]              @relation("TimesheetEntryAuditChangedBy")
  OvertimeAuditLogs                OvertimeAuditLog[]
  PayrollCalculations              PayrollCalculation[]
  OnboardingReminders              OnboardingReminder[]
  LeaveBalanceLedger               LeaveBalanceLedger[]
  OtherEntitlements                EmployeeOtherEntitlement[]

  @@unique([companyId, irdNumber])
  @@index([companyId, isActive])
  @@index([companyId, departmentId])
  @@index([companyId, jobRoleId])
  @@index([companyId, userId])
}

model EmployeeOtherEntitlement {
  id            String         @id @default(cuid())
  employeeId    String
  companyId     String
  name          String // e.g., "Time in Lieu", "Bereavement Days", "Study Leave"
  balance       Decimal        @db.Decimal(8, 2) // Current balance (days or hours)
  unit          String         @default("days") // "days" or "hours"
  notes         String? // Optional notes about this entitlement
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  Employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  LeaveRequests LeaveRequest[]

  @@unique([employeeId, name])
  @@index([companyId, employeeId])
}

model EmployeePerformanceReview {
  id                  String                @id
  employeeId          String
  companyId           String
  reviewerId          String?
  reviewType          PerformanceReviewType @default(MANAGER_REVIEW)
  isAnonymous         Boolean               @default(false)
  reviewDate          DateTime
  rating              Int?
  summary             String?
  strengths           String?
  areasForImprovement String?
  goals               Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Company             Company               @relation(fields: [companyId], references: [id])
  Employee            Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Reviewer            User?                 @relation("EmployeePerformanceReviewReviewer", fields: [reviewerId], references: [id])

  @@index([employeeId, reviewDate])
  @@index([companyId])
  @@index([reviewType, isAnonymous])
}

model EmployeeOffboarding {
  id                                                 String                        @id
  employeeId                                         String                        @unique
  initiatedById                                      String
  initiatedAt                                        DateTime                      @default(now())
  completedAt                                        DateTime?
  resignationDate                                    DateTime?
  lastWorkingDate                                    DateTime
  noticePeriodDays                                   Int?
  actualLeaveDate                                    DateTime?
  offboardingReason                                  String?
  isVoluntary                                        Boolean                       @default(true)
  removeAccessImmediately                            Boolean                       @default(false)
  accessRemovedAt                                    DateTime?
  accessRemovedBy                                    String?
  assetsToReturn                                     Json?
  assetsReturned                                     Boolean                       @default(false)
  assetsReturnedAt                                   DateTime?
  assetsReturnedTo                                   String?
  handoverRequired                                   Boolean                       @default(false)
  handoverAssignedTo                                 String?
  handoverCompleted                                  Boolean                       @default(false)
  handoverCompletedAt                                DateTime?
  handoverNotes                                      String?
  finalPayCalculated                                 Boolean                       @default(false)
  finalPayAmount                                     Decimal?                      @db.Decimal(10, 2)
  unusedLeaveHours                                   Decimal?                      @db.Decimal(8, 2)
  unusedLeavePayment                                 Decimal?                      @db.Decimal(10, 2)
  benefitsEndDate                                    DateTime?
  exitInterviewRequired                              Boolean                       @default(false)
  exitInterviewScheduled                             Boolean                       @default(false)
  exitInterviewNotes                                 String?
  hrReviewRequired                                   Boolean                       @default(true)
  hrReviewCompleted                                  Boolean                       @default(false)
  hrReviewCompletedBy                                String?
  hrReviewCompletedAt                                DateTime?
  hrNotes                                            String?
  referenceContactAllowed                            Boolean                       @default(true)
  documentationArchived                              Boolean                       @default(false)
  complianceCheckCompleted                           Boolean                       @default(false)
  createdAt                                          DateTime                      @default(now())
  updatedAt                                          DateTime
  exitInterviewDate                                  DateTime?
  exitInterviewEnd                                   DateTime?
  interviewerUserId                                  String?
  interviewerName                                    String?
  interviewerEmail                                   String?
  location                                           String?
  sendForm                                           Boolean                       @default(false)
  formTemplateId                                     String?
  inviteIcsUid                                       String?
  inviteLastSentAt                                   DateTime?
  scheduledSendAt                                    DateTime?
  completionTokenHash                                String?
  tokenExpiresAt                                     DateTime?
  status                                             OffboardingStatus             @default(IN_PROGRESS)
  offboardingType                                    OffboardingType
  formTiming                                         ExitInterviewFormTiming?
  completionStatus                                   ExitInterviewCompletionStatus @default(PENDING)
  User_EmployeeOffboarding_accessRemovedByToUser     User?                         @relation("EmployeeOffboarding_accessRemovedByToUser", fields: [accessRemovedBy], references: [id])
  User_EmployeeOffboarding_assetsReturnedToToUser    User?                         @relation("EmployeeOffboarding_assetsReturnedToToUser", fields: [assetsReturnedTo], references: [id])
  Employee                                           Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ExitInterviewFormTemplate                          ExitInterviewFormTemplate?    @relation(fields: [formTemplateId], references: [id])
  User_EmployeeOffboarding_handoverAssignedToToUser  User?                         @relation("EmployeeOffboarding_handoverAssignedToToUser", fields: [handoverAssignedTo], references: [id])
  User_EmployeeOffboarding_hrReviewCompletedByToUser User?                         @relation("EmployeeOffboarding_hrReviewCompletedByToUser", fields: [hrReviewCompletedBy], references: [id])
  User_EmployeeOffboarding_initiatedByIdToUser       User                          @relation("EmployeeOffboarding_initiatedByIdToUser", fields: [initiatedById], references: [id])
  User_EmployeeOffboarding_interviewerUserIdToUser   User?                         @relation("EmployeeOffboarding_interviewerUserIdToUser", fields: [interviewerUserId], references: [id])
  ExitInterview                                      ExitInterview?
  ExitInterviewSubmission                            ExitInterviewSubmission[]
  OffboardingTask                                    OffboardingTask[]

  @@index([employeeId])
