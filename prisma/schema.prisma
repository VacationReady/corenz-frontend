// ============================================
// NZ SICK LEAVE LEDGER (Holidays Act 2003)
// ============================================

/// Ledger-based sick leave balance tracking for NZ compliance.
/// This is the single source of truth for sick leave balance changes.
/// Employee.sickLeaveBalance is a cache updated only via this ledger.
model LeaveBalanceLedger {
  id             String                  @id @default(cuid())
  employeeId     String
  companyId      String
  leaveType      LeaveBalanceLedgerType
  eventType      LeaveBalanceLedgerEvent
  /// Change in balance (hours). Positive for grants, negative for usage.
  deltaHours     Decimal                 @db.Decimal(8, 2)
  /// Balance after this transaction (hours)
  balanceAfter   Decimal                 @db.Decimal(8, 2)
  /// For grants: the eligibility/anniversary date this grant applies to
  grantDate      DateTime?
  /// Idempotency key to prevent duplicate ledger entries
  /// Format: SICK_GRANT:<employeeId>:<grantDate> or SICK_USAGE:<leaveRequestId>
  idempotencyKey String
  /// Reference to source entity (e.g., leaveRequestId for USAGE)
  sourceRef      String?
  /// Human-readable description
  description    String?
  /// Who created this entry
  createdBy      String?
  createdAt      DateTime                @default(now())

  Employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([employeeId, leaveType])
  @@index([employeeId, createdAt])
  @@index([companyId, leaveType, createdAt])
}

enum LeaveBalanceLedgerType {
  SICK_LEAVE
  // Future: ANNUAL_LEAVE, ALTERNATIVE_HOLIDAY, etc.
}

enum LeaveBalanceLedgerEvent {
  OPENING_BALANCE // Migration only
  GRANT // Anniversary grant (10 days)
  USAGE // Leave taken
  CAP_CLAMP // Balance capped at 20 days
  ADJUSTMENT // Manual HR adjustment
}

