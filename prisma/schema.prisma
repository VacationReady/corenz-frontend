generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  role          Role
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?
  name          String?
  firstName     String?
  lastName      String?
  phone         String?
  isActivated   Boolean   @default(false)

  // ✅ Relational links
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  jobRoleId String?
  jobRole   JobRole? @relation(fields: [jobRoleId], references: [id])

  managerId    String?
  manager      User?   @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates User[]  @relation("ManagerSubordinates")

  departmentHeadOf Department[] @relation("DepartmentHead") // ✅ For Department head relationship

  // ✅ HR-related fields
  employee         Employee? // Link to Employee record for HRIS core
  activationToken  ActivationToken?
  emailPreferences Json? // ✅ Optional: Store notification settings (flexible JSON)
  profileImageUrl  String? // ✅ Optional: Profile image

  // ✅ Leave and workflows
  LeaveRequest_LeaveRequest_approvedByIdToUser LeaveRequest[] @relation("LeaveRequest_approvedByIdToUser")
  leaveRequestsRequested                       LeaveRequest[] @relation("RequestingUser")

  // ✅ Documents and reports
  documents   Document[]
  SavedReport SavedReport[]

  // ✅ News/posts authored
  newsPosts             NewsPost[]
  onboardingAssignments OnboardingAssignment[]
  assignedForms         FormAssignment[]       @relation("AssignedForms")
}

model ActivationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Employee {
  id                        String                             @id @default(cuid())
  userId                    String                             @unique
  isActive                  Boolean                            @default(true)
  workingPatternId          String?
  departmentId              String?
  department                Department?                        @relation(fields: [departmentId], references: [id])
  jobRoleId                 String?
  jobRole                   JobRole?                           @relation(fields: [jobRoleId], references: [id])
  user                      User                               @relation(fields: [userId], references: [id])
  workingPattern            WorkingPattern?                    @relation(fields: [workingPatternId], references: [id])
  workingPatternAssignments EmployeeWorkingPatternAssignment[]
  leaveEntitlements         LeaveEntitlement[]
  leaveRequests             LeaveRequest[]
  Document                  Document[]
  employmentChecks          EmploymentCheck[] // add this
  driverLicences            DriverLicence[]
  trainingRecords           TrainingRecord[]
  DocumentAcknowledgement   DocumentAcknowledgement[]
  onboardingTemplateId      String? // Link to template assigned
  onboardingTemplate        OnboardingTemplate?                @relation("OnboardingTemplateEmployees", fields: [onboardingTemplateId], references: [id])
  onboardingStatus          Json? // Track step completion/status per employee (future proof)
  onboardingInstances       OnboardingInstance[]
  formAssignments           FormAssignment[]
  formSubmissions           FormSubmission[]
}

model EmployeeWorkingPatternAssignment {
  id               String         @id @default(cuid())
  employeeId       String
  workingPatternId String
  effectiveDate    DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  employee         Employee       @relation(fields: [employeeId], references: [id])
  workingPattern   WorkingPattern @relation(fields: [workingPatternId], references: [id])

  @@index([employeeId, effectiveDate])
}

model EventCategory {
  id               String             @id @default(cuid())
  name             String             @unique
  requiresApproval Boolean
  adminOnly        Boolean
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  categoryType     String
  color            String?
  eventRules       EventRule[]
  systemDefined    Boolean            @default(false)
  subcategories    EventSubcategory[]
  LeaveEntitlement LeaveEntitlement[]
  leaveRequests    LeaveRequest[]
}

model EventSubcategory {
  id                String         @id @default(cuid())
  name              String
  eventCategoryId   String
  defaultPaidStatus PaidStatus     @default(PAID)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  eventCategory     EventCategory  @relation(fields: [eventCategoryId], references: [id])
  LeaveRequest      LeaveRequest[]
}

model LeaveRequest {
  id               String            @id @default(cuid())
  startDate        DateTime
  endDate          DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  employeeId       String
  reason           String?
  approvalStatus   ApprovalStatus    @default(PENDING)
  approvedById     String?
  sickReasonId     String?
  paidStatus       PaidStatus?
  dayType          DayType
  eventCategoryId  String
  requesterId      String
  approvedBy       User?             @relation("LeaveRequest_approvedByIdToUser", fields: [approvedById], references: [id])
  employee         Employee          @relation(fields: [employeeId], references: [id])
  eventCategory    EventCategory     @relation(fields: [eventCategoryId], references: [id])
  requester        User              @relation("RequestingUser", fields: [requesterId], references: [id])
  EventSubcategory EventSubcategory? @relation(fields: [sickReasonId], references: [id])
}

model LeaveEntitlement {
  id              String   @id @default(cuid())
  employeeId      String
  createdAt       DateTime @default(now())
  totalDays       Float
  updatedAt       DateTime @updatedAt
  usedDays        Float
  daysAllocated   Float    @default(0)
  eventCategoryId String

  carryoverDays   Float     @default(0) // ✅ NEW: stores carried over days
  carryoverExpiry DateTime? // ✅ NEW: when carryover expires, optional

  employee      Employee      @relation(fields: [employeeId], references: [id])
  eventCategory EventCategory @relation(fields: [eventCategoryId], references: [id])

  @@unique([employeeId, eventCategoryId])
}

model Department {
  id          String  @id @default(cuid())
  name        String
  code        String? @unique
  description String?
  active      Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  headId String?
  head   User?   @relation("DepartmentHead", fields: [headId], references: [id])

  employees Employee[]
  users     User[]

  // 🔥 Updated M:N for document restrictions
  documents Document[] @relation("DocumentDepartments")

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  onboardingTemplates OnboardingTemplate[] @relation("OnboardingTemplateDepartments")

  @@unique([companyId, name])
}

model Company {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String? @unique // ✅ Optional: ERP/payroll sync code
  industry String? // ✅ Optional: Industry classification
  size     Int? // ✅ Optional: Employee count (cached for reporting)
  address  String? // ✅ Optional: Company HQ address
  phone    String? // ✅ Optional: Contact number
  website  String? // ✅ Optional: Corporate website

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  jobRoles    JobRole[] // ✅ Added for multi-tenant job role relation

  SavedReport         SavedReport[]
  documents           Document[]
  onboardingTemplates OnboardingTemplate[]
  users               User[]
  forms               Form[]
}

model JobRole {
  id          String  @id @default(cuid())
  name        String
  description String?
  active      Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  payGrade String?
  level    Int?

  users     User[]
  employees Employee[] // ✅ Added opposite relation to Employee

  // 🔥 Added M:N relation for document restrictions
  documents Document[] @relation("DocumentJobRoles")

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  onboardingTemplates OnboardingTemplate[] @relation("OnboardingTemplateJobRoles")

  @@unique([companyId, name])
}

model WorkingPattern {
  id                 String                             @id @default(cuid())
  name               String
  active             Boolean                            @default(true)
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  description        String?
  employees          Employee[]
  assignments        EmployeeWorkingPatternAssignment[]
  WorkingPatternWeek WorkingPatternWeek[]
}

model WorkingPatternDay {
  id                   String             @id @default(cuid())
  day                  String
  type                 DayType
  workingPatternWeekId String
  WorkingPatternWeek   WorkingPatternWeek @relation(fields: [workingPatternWeekId], references: [id], onDelete: Cascade)

  @@unique([day, workingPatternWeekId])
}

model WorkingPatternWeek {
  id                String              @id @default(cuid())
  weekNumber        Int
  workingPatternId  String
  WorkingPatternDay WorkingPatternDay[]
  WorkingPattern    WorkingPattern      @relation(fields: [workingPatternId], references: [id], onDelete: Cascade)

  @@unique([weekNumber, workingPatternId])
}

model EventRule {
  id                    String  @id @default(cuid())
  companyId             String
  eventCategoryId       String
  enforceEntitlement    Boolean @default(true)
  noticePeriodDays      Int     @default(0)
  maxConcurrent         Int?
  maxBookingLength      Int?
  maxCarryoverDays      Int? // ✅ max days to carry over; null disables carryover
  carryoverExpiryMonths Int? // ✅ null disables expiry; if set, carryover expires X months after leave year end

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventCategory EventCategory @relation(fields: [eventCategoryId], references: [id])

  @@unique([companyId, eventCategoryId])
}

model BlackoutDay {
  id               String   @id @default(cuid())
  date             DateTime
  companyId        String
  allEvents        Boolean  @default(false)
  eventCategoryIds String[] // stores IDs of categories this blackout applies to (empty if allEvents=true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FieldMetadata {
  id           String   @id @default(cuid())
  model        String // e.g., "user", "employee"
  field        String // e.g., "email", "isActive"
  label        String // e.g., "Email", "Is Active"
  fieldType    String // e.g., "string", "boolean", "date"
  isReportable Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model SavedReport {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category    String
  fields      String[] // ✅ clean native array
  filters     Json?
  sort        Json?
  pagination  Json?
  createdBy   String
  user        User     @relation(fields: [createdBy], references: [id])
  companyId   String?
  Company     Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id          String    @id @default(cuid())
  name        String
  category    String?
  description String?
  path        String
  size        Int
  type        String
  url         String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  // Relations
  uploader   User      @relation(fields: [uploaderId], references: [id])
  uploaderId String
  company    Company   @relation(fields: [companyId], references: [id])
  companyId  String
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?

  // 🔥 M:N Visibility Restrictions
  departments Department[] @relation("DocumentDepartments")
  jobRoles    JobRole[]    @relation("DocumentJobRoles")

  // Access Control Flags
  canViewAdmin    Boolean @default(true)
  canViewManager  Boolean @default(false)
  canViewEmployee Boolean @default(true)

  // Acknowledgement
  requiresAck      Boolean                   @default(false) // ✅ NEW
  acknowledgements DocumentAcknowledgement[] // ✅ NEW RELATION

  // Other Relations
  driverLicences            DriverLicence[]
  trainingRecords           TrainingRecord[]
  requireAckFromNewStarters Boolean          @default(false)
  onboardingSteps           OnboardingStep[]
}

model DocumentAcknowledgement {
  id                String           @id @default(cuid())
  document          Document         @relation(fields: [documentId], references: [id])
  documentId        String
  employee          Employee         @relation(fields: [employeeId], references: [id])
  employeeId        String
  acknowledgedAt    DateTime         @default(now())
  EmploymentCheck   EmploymentCheck? @relation(fields: [employmentCheckId], references: [id])
  employmentCheckId String?

  @@unique([documentId, employeeId]) // ✅ Prevent duplicates
}

model EmploymentCheck {
  id             String   @id @default(cuid())
  employeeId     String
  typeOfCheck    String
  documentNumber String
  dateOfIssue    DateTime
  expiryDate     DateTime
  documentUrl    String? // optional link to uploaded document
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee                 Employee                  @relation(fields: [employeeId], references: [id])
  documentAcknowledgements DocumentAcknowledgement[] // ✅ NEW back-reference
}

model DriverLicence {
  id            String   @id @default(cuid())
  employeeId    String
  type          String
  licenceNumber String
  issueDate     DateTime
  expiryDate    DateTime
  documentId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])
}

model TrainingRecord {
  id            String    @id @default(cuid())
  employeeId    String
  courseId      String
  providerId    String
  dateCompleted DateTime
  expiryDate    DateTime?
  documentId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee         @relation(fields: [employeeId], references: [id])
  document Document?        @relation(fields: [documentId], references: [id])
  course   Course           @relation(fields: [courseId], references: [id])
  provider TrainingProvider @relation(fields: [providerId], references: [id])
}

model ExpiryRule {
  id             String   @id @default(cuid())
  category       String   @unique
  daysBefore     Int
  notifyAdmin    Boolean  @default(true)
  notifyManager  Boolean  @default(true)
  notifyEmployee Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model NewsPost {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  content       Json // Rich text (e.g. from Editor.js or Tiptap)
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  publishedAt   DateTime?
  pinned        Boolean   @default(false)
  tags          String[] // e.g. ["Policy", "Wellbeing"]
  audience      Json // Flexible: store dept/location/role filters here
  attachments   String[] // Supabase file URLs
  videoEmbedUrl String? // Optional video URL
  sendEmail     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Course {
  id              String           @id @default(cuid())
  name            String           @unique
  trainingRecords TrainingRecord[]
}

model TrainingProvider {
  id              String           @id @default(cuid())
  name            String           @unique
  trainingRecords TrainingRecord[]
}

model Location {
  id   String @id @default(uuid())
  name String @unique
}

model OnboardingTemplate {
  id          String           @id @default(cuid())
  name        String
  description String?
  isActive    Boolean          @default(false)
  isDefault   Boolean          @default(false)
  steps       OnboardingStep[]
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  employees             Employee[]             @relation("OnboardingTemplateEmployees")
  departments           Department[]           @relation("OnboardingTemplateDepartments")
  jobRoles              JobRole[]              @relation("OnboardingTemplateJobRoles")
  onboardingInstances   OnboardingInstance[]
  onboardingAssignments OnboardingAssignment[]

  @@unique([companyId, name])
}

model OnboardingStep {
  id                      String                   @id @default(cuid())
  type                    OnboardingStepType
  label                   String // e.g. 'Acknowledge H&S Policy', 'Upload Right to Work', etc.
  order                   Int // Drag/drop step order
  templateId              String
  template                OnboardingTemplate       @relation(fields: [templateId], references: [id])
  // --- Step-specific fields (one used per type) ---
  documentId              String? // For acknowledge-document step
  document                Document?                @relation(fields: [documentId], references: [id])
  uploadType              OnboardingUploadType? // For upload steps (e.g. passport, right to work)
  instruction             String? // For simple instruction/checklist steps
  onboardingStepInstances OnboardingStepInstance[]

  @@unique([templateId, label])
}

model OnboardingInstance {
  id          String                   @id @default(cuid())
  employeeId  String
  employee    Employee                 @relation(fields: [employeeId], references: [id])
  templateId  String
  template    OnboardingTemplate       @relation(fields: [templateId], references: [id])
  startedAt   DateTime                 @default(now())
  completedAt DateTime?
  status      String                   @default("active")
  steps       OnboardingStepInstance[]
}

model OnboardingStepInstance {
  id                   String                   @id @default(cuid())
  onboardingInstanceId String
  onboardingInstance   OnboardingInstance       @relation(fields: [onboardingInstanceId], references: [id])
  stepId               String
  step                 OnboardingStep           @relation(fields: [stepId], references: [id])
  status               String // "pending", "completed"
  completedAt          DateTime?
  order                Int                      @default(0)
  responses            OnboardingStepResponse[]
}

model OnboardingStepResponse {
  id                       String                 @id @default(cuid())
  onboardingStepInstanceId String
  onboardingStepInstance   OnboardingStepInstance @relation(fields: [onboardingStepInstanceId], references: [id])
  response                 Json
  createdAt                DateTime               @default(now())
}

model OnboardingAssignment {
  id          String             @id @default(uuid())
  userId      String
  templateId  String
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  progress    Json? // [{stepId: string, completed: boolean, completedAt: DateTime?}]
  // relations
  user        User               @relation(fields: [userId], references: [id])
  template    OnboardingTemplate @relation(fields: [templateId], references: [id])
}

model Form {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  name        String
  description String?
  schema      Json // Field definitions
  version     Int      @default(1)
  isActive    Boolean  @default(true)

  // Role-based visibility
  visibleToRoles      Role[]   @default([ADMIN, MANAGER, EMPLOYEE])
  visibleToDepartments String[] @default([]) // Department IDs
  visibleToJobRoles   String[] @default([]) // JobRole IDs

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments FormAssignment[]
  submissions FormSubmission[]
}

model FormAssignment {
  id           String    @id @default(cuid())
  form         Form      @relation(fields: [formId], references: [id])
  formId       String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  employeeId   String
  assignedBy   User      @relation("AssignedForms", fields: [assignedById], references: [id])
  assignedById String
  dueDate      DateTime?
  status       String    @default("pending")
  completedAt  DateTime?
}

model FormSubmission {
  id          String   @id @default(cuid())
  form        Form     @relation(fields: [formId], references: [id])
  formId      String
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String
  data        Json
  submittedAt DateTime @default(now())
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum DayType {
  FULL_DAY
  HALF_DAY_AM
  HALF_DAY_PM
}

enum EventType {
  TIME_OFF
  WORKING_EVENT
}

enum PaidStatus {
  PAID
  UNPAID
}

enum LeaveType {
  ANNUAL
  SICK
  BEREAVEMENT
}

enum OnboardingStepType {
  ACKNOWLEDGE_DOCUMENT // Read & acknowledge a document (docId required)
  UPLOAD_DOCUMENT // Upload a document (type required, e.g. "Right to Work")
  INSTRUCTION // Custom instruction/checklist
}

enum OnboardingUploadType {
  PASSPORT
  RIGHT_TO_WORK
  DRIVER_LICENSE
  TRAINING_CERTIFICATE
  OTHER
}
