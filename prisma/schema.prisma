model WorkingPattern {
  id                               String                             @id
  name                             String
  active                           Boolean                            @default(true)
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime
  description                      String?
  companyId                        String
  Employee                         Employee[]
  EmployeeWorkingPatternAssignment EmployeeWorkingPatternAssignment[]
  Company                          Company                            @relation(fields: [companyId], references: [id])
  WorkingPatternWeek               WorkingPatternWeek[]
}

model WorkingPatternDay {
  id                   String             @id
  day                  String
  type                 DayType
  hoursPerDay          Decimal?           @db.Decimal(4, 2) // e.g., 7.5, 8.0, 10.0
  startTime            String?            // e.g., "09:00" (24-hour format)
  endTime              String?            // e.g., "17:00" (24-hour format)
  workingPatternWeekId String
  WorkingPatternWeek   WorkingPatternWeek @relation(fields: [workingPatternWeekId], references: [id], onDelete: Cascade)

  @@unique([day, workingPatternWeekId])
}

model WorkingPatternWeek {
  id                String              @id
  weekNumber        Int
  totalHours        Decimal             @db.Decimal(5, 2) @default(0.00) // Auto-calculated sum of day hours
  workingPatternId  String
  WorkingPatternDay WorkingPatternDay[]
  WorkingPattern    WorkingPattern      @relation(fields: [workingPatternId], references: [id], onDelete: Cascade)

  @@unique([weekNumber, workingPatternId])
}

model ApprovalWorkflow {
  id              String                  @id @default(cuid())
  companyId       String
  name            String
  eventCategoryId String
  scopeType       ApprovalScopeType
  departmentIds   String[]                @default([])
  jobRoleIds      String[]                @default([])
  employeeIds     String[]                @default([])
  priority        Int                     @default(0)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  Company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  EventCategory   EventCategory           @relation(fields: [eventCategoryId], references: [id])
  stages          ApprovalWorkflowStage[]

  @@unique([companyId, name])
  @@index([companyId, eventCategoryId])
}

model ApprovalWorkflowStage {
  id         String                          @id @default(cuid())
  workflowId String
  name       String?
  order      Int
  mode       ApprovalStageMode
  createdAt  DateTime                        @default(now())
  updatedAt  DateTime                        @updatedAt
  workflow   ApprovalWorkflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approvers  ApprovalWorkflowStageApprover[]

  @@unique([workflowId, order])
}

model ApprovalWorkflowStageApprover {
  id      String                @id @default(cuid())
  stageId String
  type    ApproverType          @default(USER)
  userId  String?
  order   Int
  stage   ApprovalWorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user    User?                 @relation("ApprovalWorkflowStageApprover_userIdToUser", fields: [userId], references: [id])

  @@unique([stageId, order])
  // Unique per user only when a user is provided
  @@unique([stageId, userId])
}

model LeaveApprovalStage {
  id              String                  @id @default(cuid())
  leaveRequestId  String
  workflowStageId String?
  name            String?
  order           Int
  mode            ApprovalStageMode
  status          ApprovalStatus          @default(PENDING)
  isActive        Boolean                 @default(false)
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  decisions       LeaveApprovalDecision[]
  leaveRequest    LeaveRequest            @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId, order])
}

model LeaveApprovalDecision {
  id          String             @id @default(cuid())
  stageId     String
  approverId  String
  order       Int
  status      ApprovalStatus     @default(PENDING)
  isActive    Boolean            @default(false)
  respondedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  approver    User               @relation("LeaveApprovalDecision_approverIdToUser", fields: [approverId], references: [id])
  stage       LeaveApprovalStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, approverId])
  @@unique([stageId, order])
  @@index([approverId, status, isActive])
}

