# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================

# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/corenz_db

# NextAuth configuration
NEXTAUTH_SECRET=CHANGE_ME_TO_RANDOM_STRING_MIN_32_CHARS
NEXTAUTH_URL=https://your-domain.com

# Email sender address
FROM_EMAIL=noreply@peoplecore.co.nz

# =============================================================================
# OPTIONAL OAUTH PROVIDERS
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Azure AD OAuth
# AZURE_AD_CLIENT_ID=your_azure_client_id
# AZURE_AD_CLIENT_SECRET=your_azure_client_secret
# AZURE_AD_TENANT_ID=your_azure_tenant_id

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Optional: Redis for distributed rate limiting across instances
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=your_kv_token
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# =============================================================================
# EMAIL SERVICE (Resend)
# =============================================================================

# RESEND_API_KEY=re_your_api_key
# HR_INBOX_EMAIL=hr@yourcompany.com

# =============================================================================
# AI FEATURES (OpenAI)
# =============================================================================

# OPENAI_API_KEY=sk-your-api-key
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_FINE_TUNED_MODEL=ft:gpt-4o-mini:your-org:model-name:identifier
# OPENAI_TEMPERATURE=0.7

# =============================================================================
# FILE STORAGE (Supabase)
# =============================================================================

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Public-facing application URL (IMPORTANT: Required for logout to redirect correctly)
# This ensures users are redirected to production, not stale preview deployments
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Main production company ID (for multi-tenant setups)
# NEXT_PUBLIC_MAIN_PRODUCTION_COMPANY_ID=your_company_id

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Unified Audit System: dual-write to legacy EmployeeAuditLog table
UNIFIED_AUDIT_DUALWRITE=true

# =============================================================================
# SECURITY & ACCESS
# =============================================================================

# Tenant Admin Portal password (min 8 characters)
# TENANT_ADMIN_PASSWORD=your_secure_password_here

# Password reset rate limiting
PASSWORD_RESET_LIMIT=3
PASSWORD_RESET_WINDOW_MS=900000

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# Enable Prisma query logging
# LOG_PRISMA=true

# Seed user secret - required for /api/seed-user endpoint (development only)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SEED_USER_SECRET=your_random_secret_here
