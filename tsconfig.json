{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    // Disabled for .js scripts and legacy code - migrate or exclude explicitly
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["app/*"],
      "@/components/*": ["app/components/*"],
      "@/lib/*": ["app/lib/*"],
      "@/types/*": ["app/types/*"],
      "@/hooks/*": ["app/hooks/*"]
    },
    "types": ["next-auth"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Enhanced strictness flags
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Relaxed for gradual migration - re-enable when codebase is ready
    // "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Disabled for now - creates too many errors in existing code
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "types/next-auth.d.ts"
  ],
  "exclude": ["node_modules", "scripts/**/*.js", "mobile", "prisma/seed.js"]
}
