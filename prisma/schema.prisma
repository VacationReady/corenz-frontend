// Cascading Objectives - Company level objectives
model CompanyObjective {
  id          String            @id
  companyId   String
  title       String
  description String?
  owner       String? // User who owns this objective
  status      ObjectiveStatus   @default(NOT_STARTED)
  progress    Int               @default(0)
  dueDate     DateTime?
  startDate   DateTime?
  priority    ObjectivePriority @default(MEDIUM)
  tags        String[]          @default([])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   String

  // Relationships
  Company Company @relation(fields: [companyId], references: [id])
  Owner   User?   @relation("CompanyObjectiveOwner", fields: [owner], references: [id])
  Creator User    @relation("CompanyObjectiveCreator", fields: [createdBy], references: [id])

  keyResults     ObjectiveKeyResult[]
  teamObjectives TeamObjective[]      @relation("CompanyObjectiveAlignment")
  updates        ObjectiveUpdate[]

  @@index([companyId, status])
  @@index([owner])
  @@index([dueDate])
}

// Team/Department level objectives
model TeamObjective {
  id                String            @id
  companyId         String
  teamId            String? // Department/Team ID
  title             String
  description       String?
  owner             String? // User who owns this objective
  parentObjectiveId String? // Links to CompanyObjective
  status            ObjectiveStatus   @default(NOT_STARTED)
  progress          Int               @default(0)
  dueDate           DateTime?
  startDate         DateTime?
  priority          ObjectivePriority @default(MEDIUM)
  tags              String[]          @default([])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String

  // Relationships
  Owner           User?             @relation("TeamObjectiveOwner", fields: [owner], references: [id])
  ParentObjective CompanyObjective? @relation("CompanyObjectiveAlignment", fields: [parentObjectiveId], references: [id])
  Creator         User              @relation("TeamObjectiveCreator", fields: [createdBy], references: [id])

  keyResults         ObjectiveKeyResult[]
  personalObjectives PersonalObjective[]  @relation("TeamObjectiveAlignment")
  updates            ObjectiveUpdate[]

  @@index([teamId])
  @@index([parentObjectiveId])
  @@index([owner])
}

// Individual/Personal objectives
model PersonalObjective {
  id                String              @id
  employeeId        String
  companyId         String
  title             String
  description       String?
  parentObjectiveId String? // Links to TeamObjective
  status            ObjectiveStatus     @default(NOT_STARTED)
  progress          Int                 @default(0)
  dueDate           DateTime?
  startDate         DateTime?
  priority          ObjectivePriority   @default(MEDIUM)
  tags              String[]            @default([])
  visibility        ObjectiveVisibility @default(TEAM)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relationships
  ParentObjective TeamObjective? @relation("TeamObjectiveAlignment", fields: [parentObjectiveId], references: [id])

  keyResults ObjectiveKeyResult[]
  updates    ObjectiveUpdate[]

  @@index([employeeId])
  @@index([parentObjectiveId])
  @@index([companyId])
}

// Key Results for objectives (OKR style)
model ObjectiveKeyResult {
  id           String          @id
  title        String
  description  String?
  targetValue  Float
  currentValue Float           @default(0)
  unit         String? // e.g., "%", "users", "revenue"
  status       ObjectiveStatus @default(NOT_STARTED)
  dueDate      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Polymorphic relationship to objectives
  companyObjectiveId  String?
  teamObjectiveId     String?
  personalObjectiveId String?

  // Relationships
  CompanyObjective  CompanyObjective?  @relation(fields: [companyObjectiveId], references: [id], onDelete: Cascade)
  TeamObjective     TeamObjective?     @relation(fields: [teamObjectiveId], references: [id], onDelete: Cascade)
  PersonalObjective PersonalObjective? @relation(fields: [personalObjectiveId], references: [id], onDelete: Cascade)

  @@index([companyObjectiveId])
  @@index([teamObjectiveId])
  @@index([personalObjectiveId])
}

// Progress updates and comments on objectives
model ObjectiveUpdate {
  id        String   @id
  content   String
  progress  Int? // Progress percentage at time of update
  authorId  String
  createdAt DateTime @default(now())

  // Polymorphic relationship to objectives
  companyObjectiveId  String?
  teamObjectiveId     String?
  personalObjectiveId String?

  // Relationships
  Author            User               @relation(fields: [authorId], references: [id])
  CompanyObjective  CompanyObjective?  @relation(fields: [companyObjectiveId], references: [id], onDelete: Cascade)
  TeamObjective     TeamObjective?     @relation(fields: [teamObjectiveId], references: [id], onDelete: Cascade)
  PersonalObjective PersonalObjective? @relation(fields: [personalObjectiveId], references: [id], onDelete: Cascade)

  @@index([companyObjectiveId])
  @@index([teamObjectiveId])
  @@index([personalObjectiveId])
  @@index([authorId])
}

// Performance meeting templates (1-2-1, review templates)
model PerformanceTemplate {
  id          String             @id
  companyId   String
  name        String
  description String?
  type        TemplateType
  icon        String?
  isDefault   Boolean            @default(false)
  isActive    Boolean            @default(true)
  version     Int                @default(1)
  tags        String[]           @default([])
  visibility  TemplateVisibility @default(COMPANY)

  // New fields for advanced template configuration
  audienceFilters     Json? // { locations: string[], departments: string[], jobRoles: string[] }
  reviewerAssignments Json? // [{ role: ReviewerRole; dueOffsetDays?: number }]
  bestPracticePackIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  Creator User @relation(fields: [createdBy], references: [id])

  sections     TemplateSection[]
  meetings     PerformanceMeeting[]
  reviewCycles PerformanceReviewCycle[]

  @@index([companyId, type])
  @@index([isActive])
}

// Template sections/questions
model TemplateSection {
  id          String  @id
  templateId  String
  title       String
  description String?
  order       Int
  isRequired  Boolean @default(false)

  // Relationships
  Template PerformanceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  questions TemplateQuestion[]

  @@index([templateId, order])
}

// Individual questions within sections
model TemplateQuestion {
  id          String       @id
  sectionId   String
  question    String
  description String?
  type        QuestionType @default(TEXT)
  order       Int
  isRequired  Boolean      @default(false)
  options     Json? // For multiple choice/rating questions

  // Question-level permissions for who can see/answer
  visibleToRoles    String[] @default([]) // Roles that can see this question
  requiredFromRoles String[] @default([]) // Roles that must answer this question
  hideFromEmployee  Boolean  @default(false) // Hide from employee even if in their role

  // Relationships
  Section TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, order])
}

// 1-2-1 and performance meetings
model PerformanceMeeting {
  id             String        @id
  companyId      String
  title          String
  description    String?
  templateId     String?
  organizerId    String
  participantIds String[] // Array of user IDs
  scheduledAt    DateTime
  duration       Int           @default(60) // Minutes
  location       String?
  meetingUrl     String?
  status         MeetingStatus @default(SCHEDULED)
  agenda         Json? // Pre-filled from template
  isRecurring    Boolean       @default(false)
  recurrence     Json? // Recurrence rules
  seriesId       String? // For recurring meetings
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  // Relationships
  Template  PerformanceTemplate? @relation(fields: [templateId], references: [id])
  Organizer User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id])

  notes       MeetingNote[]
  actionItems MeetingActionItem[]

  @@index([companyId, scheduledAt])
  @@index([organizerId])
  @@index([status])
  @@index([seriesId])
}

// Meeting notes captured during 1-2-1s
model MeetingNote {
  id           String   @id
  meetingId    String
  content      String
  authorId     String
  sectionTitle String? // From template section
  isPrivate    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  Meeting PerformanceMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  Author  User               @relation(fields: [authorId], references: [id])

  @@index([meetingId])
  @@index([authorId])
}

// Action items from meetings
model MeetingActionItem {
  id          String             @id
  meetingId   String
  title       String
  description String?
  assigneeId  String
  dueDate     DateTime?
  status      ActionItemStatus   @default(TODO)
  priority    ActionItemPriority @default(MEDIUM)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  completedAt DateTime?

  // Relationships
  Meeting  PerformanceMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  Assignee User               @relation("MeetingActionItemAssignee", fields: [assigneeId], references: [id])

  @@index([meetingId])
  @@index([assigneeId, status])
  @@index([dueDate])
}

// 360 Review Cycles
model PerformanceReviewCycle {
  id                    String          @id
  companyId             String
  name                  String
  description           String?
  templateId            String?
  type                  ReviewCycleType @default(ANNUAL)
  status                CycleStatus     @default(DRAFT)
  startDate             DateTime
  endDate               DateTime
  selfReviewDeadline    DateTime?
  managerReviewDeadline DateTime?
  peerReviewDeadline    DateTime?
  isAnonymousPeer       Boolean         @default(true)
  participantIds        String[] // Employees in this cycle
  settings              Json? // Cycle-specific settings
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  createdBy             String

  // Relationships
  Template PerformanceTemplate? @relation(fields: [templateId], references: [id])
  Creator  User                 @relation(fields: [createdBy], references: [id])

  participants CycleParticipant[]
  insights     CycleInsight[]

  @@index([companyId, status])
  @@index([startDate, endDate])
}

// Participants in review cycles (employees being reviewed)
model CycleParticipant {
  id                       String            @id
  cycleId                  String
  employeeId               String
  status                   ParticipantStatus @default(NOT_STARTED)
  selfReviewCompleted      Boolean           @default(false)
  selfReviewCompletedAt    DateTime?
  managerReviewCompleted   Boolean           @default(false)
  managerReviewCompletedAt DateTime?
  peerReviewsRequested     Int               @default(0)
  peerReviewsCompleted     Int               @default(0)
  overallScore             Float?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  // Relationships
  Cycle PerformanceReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  reviews ReviewSubmission[]

  @@unique([cycleId, employeeId])
  @@index([cycleId, status])
  @@index([employeeId])
}

// Individual review submissions (self, manager, peer, direct report)
model ReviewSubmission {
  id               String           @id
  participantId    String
  cycleId          String
  reviewerId       String
  reviewerRole     ReviewerRole
  revieweeId       String // Person being reviewed
  responses        Json // Answers to template questions
  overallRating    Float?
  strengths        String?
  developmentAreas String?
  comments         String?
  status           SubmissionStatus @default(DRAFT)
  isAnonymous      Boolean          @default(false)
  submittedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relationships
  Participant CycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  Reviewer    User             @relation("ReviewSubmissionReviewer", fields: [reviewerId], references: [id])

  @@index([participantId])
  @@index([cycleId])
  @@index([reviewerId])
  @@index([revieweeId])
}

// Analytics and insights from review cycles
model CycleInsight {
  id          String      @id
  cycleId     String
  insightType InsightType
  title       String
  description String?
  data        Json // Aggregated data/metrics
  generatedAt DateTime    @default(now())

  // Relationships
  Cycle PerformanceReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, insightType])
}

// Notification rules for performance events
model PerformanceNotificationRule {
  id              String                           @id
  companyId       String
  name            String
  description     String?
  eventType       NotificationEventType
  recipientRoles  String[] // EMPLOYEE, MANAGER, HR, ADMIN
  offsetDays      Int? // Days before/after event
  channels        PerformanceNotificationChannel[] // EMAIL, IN_APP, SLACK
  templateContent Json? // Email template
  isActive        Boolean                          @default(true)
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt

  @@index([companyId, eventType])
  @@index([isActive])
}

// Enums for Performance Management

enum PerformanceReviewType {
  MANAGER_REVIEW
  PEER_REVIEW
  SELF_REVIEW
  UPWARD_REVIEW
  REVIEW_360
}

enum ObjectiveStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  COMPLETED
  CANCELLED
  DEFERRED
}

enum ObjectivePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================
// TIME TRACKING & SCHEDULING MODELS
// ============================================

model ClockEntry {
  id               String           @id @default(cuid())
  employeeId       String
  companyId        String
  clockInTime      DateTime
  clockOutTime     DateTime?
  clockInLocation  Json? // {lat, lng, accuracy}
  clockOutLocation Json? // {lat, lng, accuracy}
  clockInPhotoUrl  String?
  clockOutPhotoUrl String?
  ipAddress        String?
  deviceInfo       Json? // {device, os, browser}
  status           ClockEntryStatus @default(ACTIVE)
  notes            String?
  timesheetId      String?
  localId          String? // Client-generated ID for offline entries
  syncedAt         DateTime? // When offline entry was synced to server
  offlineCreated   Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Shift Reconciliation fields (all optional for backwards compatibility)
  shiftId         String? // Link to scheduled shift for reconciliation
  matchConfidence Float? // 0-1, how confident the auto-match is
  matchedBy       String? // 'AUTO' | 'MANUAL' | userId who matched
  matchedAt       DateTime? // When the match was made

  Employee  Employee   @relation("ClockEntryEmployee", fields: [employeeId], references: [id])
  Timesheet Timesheet? @relation(fields: [timesheetId], references: [id])
  Shift     Shift?     @relation("ShiftClockEntries", fields: [shiftId], references: [id])

  @@index([employeeId, clockInTime])
  @@index([companyId, status])
  @@index([timesheetId])
  @@index([localId])
  @@index([shiftId])
}

model Timesheet {
  id             String         @id @default(cuid())
  employeeId     String
  companyId      String
  periodStart    DateTime
  periodEnd      DateTime
  totalHours     Decimal        @db.Decimal(10, 2)
  regularHours   Decimal        @db.Decimal(10, 2)
  overtimeHours  Decimal        @db.Decimal(10, 2)
  breakHours     Decimal        @db.Decimal(10, 2)
  approvalStatus ApprovalStatus @default(PENDING)
  submittedAt    DateTime?
  approvedAt     DateTime?
  approvedBy     String?
  rejectedReason String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  Employee            Employee                 @relation("TimesheetEmployee", fields: [employeeId], references: [id])
  Approver            Employee?                @relation("TimesheetApprovedByEmployee", fields: [approvedBy], references: [id])
  ClockEntries        ClockEntry[]
  TimesheetEntries    TimesheetEntry[]
  ApprovalStages      TimesheetApprovalStage[]
  BreakRecords        BreakRecord[]
  PayrollCalculations PayrollCalculation[]

  @@unique([companyId, employeeId, periodStart, periodEnd])
  @@index([employeeId, periodStart])
  @@index([companyId, approvalStatus])
}

model TimesheetEntry {
  id                      String             @id @default(cuid())
  timesheetId             String
  date                    DateTime
  startTime               DateTime
  endTime                 DateTime
  breakMinutes            Int                @default(0)
  hours                   Decimal            @db.Decimal(10, 2)
  isOvertime              Boolean            @default(false)
  // Enhanced overtime tracking (NZ Employment Relations Act 2000 compliance)
  overtimeType            String? // MANUAL, AUTO_DAILY, AUTO_WEEKLY, AUTO_MONTHLY, AUTO_PATTERN, MANAGER_ADJUSTED
  overtimeHours           Decimal?           @db.Decimal(5, 2) // Actual OT hours for this entry
  regularHours            Decimal?           @db.Decimal(5, 2) // Regular hours for this entry
  overtimeMultiplier      Decimal?           @db.Decimal(3, 2) // Rate applied (1.5x, 2.0x)
  overtimeReason          String? // Explanation of why it's OT
  managerAdjusted         Boolean            @default(false)
  managerAdjustedBy       String? // User ID of manager who adjusted
  managerAdjustedAt       DateTime? // When the adjustment was made
  managerAdjustmentNote   String? // Reason for manager adjustment
  notes                   String?
  entryType               TimesheetEntryType @default(MANUAL)
  // Public Holiday Tracking (Holidays Act 2003 compliance)
  isPublicHoliday         Boolean            @default(false)
  publicHolidayName       String? // "Waitangi Day", "Christmas", "ANZAC Day"
  publicHolidayHours      Decimal            @default(0) @db.Decimal(5, 2)
  publicHolidayMultiplier Decimal            @default(2.0) @db.Decimal(3, 2)
  alternativeDayGranted   Boolean            @default(false)
  publicHolidayType       String? // NATIONAL, REGIONAL, MONDAYISED
  publicHolidayRegion     String? // AUCKLAND, WELLINGTON, etc.
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Shift Reconciliation fields (all optional for backwards compatibility)
  shiftId              String? // Link to scheduled shift for reconciliation
  scheduledStartTime   DateTime? // Copy of shift start for quick reference
  scheduledEndTime     DateTime? // Copy of shift end for quick reference
  varianceMinutes      Int? // Positive = worked more, negative = worked less
  varianceType         String? // 'EARLY_START' | 'LATE_START' | 'EARLY_END' | 'LATE_END' | 'OVERTIME' | 'UNDERTIME'
  reconciliationStatus String    @default("PENDING") // 'PENDING' | 'AUTO_MATCHED' | 'MANUALLY_MATCHED' | 'APPROVED' | 'ADJUSTED' | 'FLAGGED'
  reconciliationNotes  String? // Notes from reconciliation process
  reconciledBy         String? // User ID who reconciled
  reconciledAt         DateTime? // When reconciliation was done

  Timesheet         Timesheet             @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  Shift             Shift?                @relation("ShiftTimesheetEntries", fields: [shiftId], references: [id])
  AuditLogs         TimesheetEntryAudit[]
  OvertimeAuditLogs OvertimeAuditLog[]

  @@index([timesheetId, date])
  @@index([date, isOvertime])
  @@index([date, isPublicHoliday])
  @@index([shiftId])
  @@index([reconciliationStatus])
}

model TimesheetApprovalStage {
  id              String            @id @default(cuid())
  timesheetId     String
  workflowStageId String?
  name            String?
  order           Int
  mode            ApprovalStageMode
  status          ApprovalStatus    @default(PENDING)
  isActive        Boolean           @default(false)
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  Timesheet Timesheet                   @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  Decisions TimesheetApprovalDecision[]

  @@index([timesheetId, order])
}

model TimesheetApprovalDecision {
  id          String         @id @default(cuid())
  stageId     String
  approverId  String
  order       Int
  status      ApprovalStatus @default(PENDING)
  isActive    Boolean        @default(false)
  comments    String?
  respondedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  Stage TimesheetApprovalStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, approverId])
  @@unique([stageId, order])
  @@index([approverId, status, isActive])
}

model TimesheetEntryAudit {
  id           String   @id @default(cuid())
  entryId      String
  timesheetId  String
  employeeId   String
  changedById  String // Manager/Admin who made the change
  changeReason String? // Reason for the change
  field        String // Field that was changed (startTime, endTime, hours, etc.)
  oldValue     String? // JSON stringified old value
  newValue     String? // JSON stringified new value
  changeType   String // CREATED, UPDATED, DELETED
  changedAt    DateTime @default(now())
  companyId    String

  Entry     TimesheetEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  Employee  Employee       @relation("TimesheetEntryAuditEmployee", fields: [employeeId], references: [id])
  ChangedBy Employee       @relation("TimesheetEntryAuditChangedBy", fields: [changedById], references: [id])

  @@index([entryId, changedAt])
  @@index([timesheetId, changedAt])
  @@index([employeeId])
  @@index([changedById])
}

model ShiftTemplate {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  startTime      String // HH:MM format
  endTime        String // HH:MM format
  breakDuration  Int      @default(30) // minutes
  role           String?
  requiredSkills String[] @default([])
  departmentId   String?
  locationId     String?
  rotaGroupId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Shifts    Shift[]
  RotaGroup RotaGroup? @relation(fields: [rotaGroupId], references: [id], onDelete: SetNull)

  @@unique([companyId, name])
  @@index([rotaGroupId])
}

model Shift {
  id                   String                @id @default(cuid())
  companyId            String
  employeeId           String?
  templateId           String?
  departmentId         String?
  locationId           String?
  rotaGroupId          String?
  startTime            DateTime
  endTime              DateTime
  breakDuration        Int                   @default(0) // minutes
  notes                String?
  role                 String?
  requiredSkills       String[]              @default([])
  isPublished          Boolean               @default(false)
  requiresConfirmation Boolean               @default(false)
  confirmedAt          DateTime?
  attendanceStatus     ShiftAttendanceStatus @default(SCHEDULED)
  cost                 Decimal?              @db.Decimal(10, 2)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdBy            String

  Employee          Employee?          @relation("ShiftEmployee", fields: [employeeId], references: [id])
  Location          Location?          @relation("ShiftLocation", fields: [locationId], references: [id])
  Template          ShiftTemplate?     @relation(fields: [templateId], references: [id])
  RotaGroup         RotaGroup?         @relation(fields: [rotaGroupId], references: [id], onDelete: SetNull)
  ShiftSwapRequests ShiftSwapRequest[]

  // Reconciliation relations - link to actual time worked
  ClockEntries     ClockEntry[]     @relation("ShiftClockEntries")
  TimesheetEntries TimesheetEntry[] @relation("ShiftTimesheetEntries")

  @@index([companyId, startTime])
  @@index([employeeId, startTime])
  @@index([departmentId, startTime])
  @@index([isPublished])
  @@index([rotaGroupId])
}

model ShiftSwapRequest {
  id                      String          @id @default(cuid())
  shiftId                 String
  requesterId             String
  targetEmployeeId        String?
  status                  ShiftSwapStatus @default(PENDING)
  requestMessage          String?
  responseMessage         String?
  managerApprovalRequired Boolean         @default(true)
  managerApprovedBy       String?
  managerApprovedAt       DateTime?
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  Shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([targetEmployeeId, status])
  @@index([shiftId])
}

model AvailabilityPattern {
  id          String   @id @default(cuid())
  employeeId  String
  companyId   String
  dayOfWeek   Int // 0=Sunday, 6=Saturday
  startTime   String // HH:MM format
  endTime     String // HH:MM format
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, dayOfWeek, startTime, endTime])
  @@index([employeeId, dayOfWeek])
}

model AvailabilityException {
  id          String   @id @default(cuid())
  employeeId  String
  companyId   String
  date        DateTime
  startTime   String? // HH:MM format (null = all day)
  endTime     String? // HH:MM format (null = all day)
  isAvailable Boolean  @default(false)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, date])
}

model ScheduleConflict {
  id           String           @id @default(cuid())
  companyId    String
  employeeId   String
  conflictType ConflictType
  description  String
  shift1Id     String?
  shift2Id     String?
  detectedAt   DateTime         @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
  severity     ConflictSeverity @default(MEDIUM)

  @@index([companyId, resolvedAt])
  @@index([employeeId, resolvedAt])
}

// ============================================
// ROTA GROUPS (WORKFORCE MANAGEMENT)
// ============================================

model RotaGroup {
  id             String   @id @default(cuid())
  companyId      String
  name           String // "Distribution Center - Night Shift"
  description    String?
  locationId     String?
  departmentId   String?
  roles          String[] @default([]) // ["Picker", "Packer", "Forklift Operator"]
  requiredSkills String[] @default([]) // ["RF Scanner", "Inventory System"]
  optionalTags   String[] @default([]) // ["Forklift License", "Hazmat Cert"]
  color          String? // "#8B5CF6" for calendar display
  icon           String? // "🏭" visual identifier
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Company           Company            @relation(fields: [companyId], references: [id])
  Location          Location?          @relation(fields: [locationId], references: [id])
  Department        Department?        @relation(fields: [departmentId], references: [id])
  Members           RotaGroupMember[]
  ShiftTemplates    ShiftTemplate[]
  ShiftRequirements ShiftRequirement[]
  Shifts            Shift[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([locationId])
  @@index([departmentId])
}

model RotaGroupMember {
  id             String   @id @default(cuid())
  rotaGroupId    String
  employeeId     String
  assignedRoles  String[] @default([]) // Roles employee can fill in this group
  assignedSkills String[] @default([]) // Skills this employee has for this group
  isActive       Boolean  @default(true)
  addedAt        DateTime @default(now())
  addedBy        String?

  RotaGroup RotaGroup @relation(fields: [rotaGroupId], references: [id], onDelete: Cascade)
  Employee  Employee  @relation("RotaGroupMembers", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([rotaGroupId, employeeId])
  @@index([rotaGroupId])
  @@index([employeeId])
  @@index([isActive])
}

model ShiftRequirement {
  id            String        @id @default(cuid())
  companyId     String
  rotaGroupId   String
  dayOfWeek     Int // 0=Sunday, 6=Saturday
  startTime     String // "07:00"
  endTime       String // "15:00"
  role          String // "Barista"
  quantity      Int           @default(1) // Number needed
  priority      ShiftPriority @default(NORMAL)
  breakDuration Int           @default(30)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  RotaGroup RotaGroup @relation(fields: [rotaGroupId], references: [id], onDelete: Cascade)

  @@index([rotaGroupId])
  @@index([companyId, isActive])
  @@index([dayOfWeek])
}

model PayrollExport {
  id            String   @id @default(cuid())
  companyId     String
  periodStart   DateTime
  periodEnd     DateTime
  exportedBy    String
  exportedAt    DateTime @default(now())
  format        String // CSV, EXCEL, JSON
  fileUrl       String?
  employeeCount Int
  totalHours    Decimal  @db.Decimal(10, 2)
  totalCost     Decimal? @db.Decimal(10, 2)
  metadata      Json? // Additional export settings

  @@index([companyId, exportedAt])
}

model BreakRecord {
  id          String    @id @default(cuid())
  timesheetId String?
  employeeId  String
  companyId   String
  breakType   BreakType
  startTime   DateTime
  endTime     DateTime?
  duration    Int? // minutes
  isPaid      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  Timesheet Timesheet? @relation(fields: [timesheetId], references: [id])

  @@index([employeeId, startTime])
  @@index([companyId, breakType])
}

model ComplianceViolation {
  id             String            @id @default(cuid())
  companyId      String
  employeeId     String
  violationType  ViolationType
  description    String
  detectedAt     DateTime          @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolution     String?
  severity       ViolationSeverity @default(MEDIUM)
  metadata       Json? // Additional context

  @@index([companyId, violationType])
  @@index([employeeId, detectedAt])
}

model TimeTrackingSettings {
  id                       String                  @id @default(cuid())
  companyId                String                  @unique
  // Canonical field names - GPS and Photo tracking
  requireGpsLocation       Boolean                 @default(false)
  photoRequirement         PhotoRequirement        @default(NONE)
  allowMobileClock         Boolean                 @default(true)
  // Canonical field name - Manual time entry
  allowManualTimeEntry     Boolean                 @default(true)
  // Legacy compatibility fields for UI/API alignment
  allowManualEntry         Boolean                 @default(true)
  requirePhotos            Boolean                 @default(false)
  // Geofencing and clock settings
  geofenceLocations        Json? // [{lat, lng, radius, name}]
  enableGeofencing         Boolean                 @default(false)
  geofenceRadius           Int                     @default(100) // meters
  roundClockTimes          String                  @default("NONE") // NONE, 15MIN, 30MIN
  autoClockOutHours        Int?
  // Break settings
  requireBreaks            Boolean                 @default(true)
  minBreakDuration         Int                     @default(30) // minutes
  // Timesheet period settings
  timesheetPeriod          String                  @default("WEEKLY") // WEEKLY, BIWEEKLY, MONTHLY
  periodStartDay           String                  @default("MONDAY") // MONDAY, SUNDAY, 1ST
  autoSubmit               Boolean                 @default(false)
  defaultWorkflowId        String?
  allowEditAfterSubmit     Boolean                 @default(false)
  // Shift settings
  autoSchedulingEnabled    Boolean                 @default(false)
  publishDaysAdvance       Int                     @default(7)
  requireShiftConfirmation Boolean                 @default(false)
  allowShiftSwaps          Boolean                 @default(true)
  managerApprovalSwaps     Boolean                 @default(true)
  minimumRestHours         Int                     @default(11)
  // Overtime configuration (NZ Employment Relations Act 2000 compliance)
  includeOvertimeExport    Boolean                 @default(true)
  overtimeThreshold        Decimal                 @default(40.00) @db.Decimal(5, 2)
  overtimeMultiplier       Decimal                 @default(1.50) @db.Decimal(3, 2)
  overtimeCalculationMode  OvertimeCalculationMode @default(WEEKLY)
  autoApplyOvertime        Boolean                 @default(true) // Auto-calculate OT from clock entries
  allowManualOvertimeEntry Boolean                 @default(true) // Can employees mark manual entries as OT
  blockOvertimeDuringHours Boolean                 @default(true) // Block manual OT during regular working hours
  requireOvertimeApproval  Boolean                 @default(false) // Extra approval step for OT
  dailyOvertimeThreshold   Decimal?                @db.Decimal(4, 2) // e.g., 8.0 hours
  weeklyOvertimeThreshold  Decimal?                @db.Decimal(5, 2) // e.g., 40.0 hours
  monthlyOvertimeThreshold Decimal?                @db.Decimal(6, 2) // e.g., 173.33 hours
  overtimeMultiplierTier2  Decimal?                @db.Decimal(3, 2) // e.g., 2.0x for double time
  overtimeThresholdTier2   Decimal?                @db.Decimal(5, 2) // Hours to trigger tier 2 rate
  publicHolidayMultiplier  Decimal                 @default(1.50) @db.Decimal(3, 2) // NZ public holiday rate
  sundayMultiplier         Decimal?                @db.Decimal(3, 2) // Optional Sunday premium
  enableOvertimeBreakdown  Boolean                 @default(true) // Show detailed OT breakdown in UI
  // Export settings - canonical field name
  payrollExportFormat      PayrollExportFormat     @default(CSV)
  includeBreaks            Boolean                 @default(true)
  includeNotes             Boolean                 @default(true)
  // Timestamps
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([companyId])
}

model PushNotificationToken {
  id         String   @id @default(cuid())
  employeeId String
  token      String // Expo push token
  deviceId   String
  platform   String // "ios" or "android"
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, deviceId])
  @@index([employeeId])
  @@index([token])
}

model OvertimeAuditLog {
  id                String   @id @default(cuid())
  timesheetEntryId  String
  employeeId        String
  companyId         String
  action            String // CALCULATED, MANUAL_ENTRY, MANAGER_OVERRIDE, REJECTED, APPROVED
  previousValues    Json? // Snapshot before change
  newValues         Json // Snapshot after change
  calculationMethod String? // DAILY_THRESHOLD, WEEKLY_PATTERN, MONTHLY_THRESHOLD, etc.
  triggeredBy       String // User ID who triggered the action
  triggeredAt       DateTime @default(now())
  reason            String? // Explanation for action

  TimesheetEntry TimesheetEntry @relation(fields: [timesheetEntryId], references: [id], onDelete: Cascade)
  Employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([timesheetEntryId])
  @@index([employeeId, triggeredAt])
  @@index([companyId, triggeredAt])
  @@index([action])
}

model PayrollCalculation {
  id          String @id @default(cuid())
  timesheetId String
  employeeId  String
  companyId   String

  // Earnings
  regularPay       Decimal @db.Decimal(10, 2)
  overtimePay      Decimal @default(0) @db.Decimal(10, 2)
  publicHolidayPay Decimal @default(0) @db.Decimal(10, 2)
  allowances       Decimal @default(0) @db.Decimal(10, 2)
  bonuses          Decimal @default(0) @db.Decimal(10, 2)
  commission       Decimal @default(0) @db.Decimal(10, 2)
  reimbursements   Decimal @default(0) @db.Decimal(10, 2)
  grossPay         Decimal @db.Decimal(10, 2)

  // Tax Deductions
  payeTax              Decimal @db.Decimal(10, 2)
  accLevy              Decimal @db.Decimal(10, 2)
  studentLoanDeduction Decimal @default(0) @db.Decimal(10, 2)

  // KiwiSaver
  kiwiSaverEmployee     Decimal @default(0) @db.Decimal(10, 2)
  kiwiSaverEmployeeRate Decimal @default(0.03) @db.Decimal(4, 2)
  kiwiSaverEmployer     Decimal @default(0) @db.Decimal(10, 2)
  kiwiSaverEmployerRate Decimal @default(0.03) @db.Decimal(4, 2)
  esctDeduction         Decimal @default(0) @db.Decimal(10, 2)

  // Other Deductions
  unionFees           Decimal @default(0) @db.Decimal(10, 2)
  insuranceDeductions Decimal @default(0) @db.Decimal(10, 2)
  childcareLevy       Decimal @default(0) @db.Decimal(10, 2)
  otherDeductions     Decimal @default(0) @db.Decimal(10, 2)

  // Totals
  totalDeductions Decimal @db.Decimal(10, 2)
  netPay          Decimal @db.Decimal(10, 2)
  employerCost    Decimal @db.Decimal(10, 2)

  // Pay Period
  payPeriodStart DateTime
  payPeriodEnd   DateTime
  paymentDate    DateTime
  payFrequency   String

  // Calculation Metadata
  calculatedAt       DateTime @default(now())
  calculatedBy       String
  calculationVersion String   @default("1.0")
  taxYear            String

  // Status
  status     PayrollCalculationStatus @default(DRAFT)
  approvedAt DateTime?
  approvedBy String?
  exportedAt DateTime?
  irdFiledAt DateTime?

  // Relationships
  Timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  Employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  Company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([timesheetId, employeeId])
  @@index([timesheetId])
  @@index([employeeId, payPeriodStart])
  @@index([companyId, payPeriodStart])
  @@index([status, exportedAt])
}

