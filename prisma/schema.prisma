enum ClockEntryStatus {
  ACTIVE // Currently clocked in
  COMPLETED // Clocked out
  MISSED // Missed clock out
  CANCELLED // Cancelled
}

enum TimesheetEntryType {
  CLOCK // Generated from clock entry
  MANUAL // Manually entered
  ADJUSTED // Adjusted by manager
}

enum ShiftAttendanceStatus {
  SCHEDULED // Shift scheduled
  CONFIRMED // Employee confirmed
  COMPLETED // Shift completed
  NO_SHOW // Employee didn't show up
  PARTIAL // Partially completed
  CANCELLED // Shift cancelled
}

enum ShiftSwapStatus {
  PENDING // Awaiting colleague response
  ACCEPTED // Colleague accepted
  REJECTED // Colleague rejected
  MANAGER_PENDING // Awaiting manager approval
  APPROVED // Manager approved
  DECLINED // Manager declined
  COMPLETED // Swap completed
}

enum ConflictType {
  DOUBLE_BOOKING // Two shifts at same time
  REST_PERIOD // Insufficient rest between shifts
  OVERTIME // Exceeds maximum hours
  UNAVAILABLE // Employee marked unavailable
  SKILL_MISMATCH // Employee lacks required skills
  LEAVE_CONFLICT // Conflicts with approved leave
}

enum ConflictSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ShiftPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BreakType {
  MEAL_BREAK // 30-60 min meal break
  REST_BREAK // 10-15 min rest break
  UNPAID_BREAK // Unpaid break
}

enum ViolationType {
  REST_PERIOD // NZ: Minimum 11 hours rest
  MEAL_BREAK // NZ: 30 min after 5 hours
  REST_BREAK // NZ: 10 min after 2 hours
  MAX_HOURS // Exceeds maximum hours
  OVERTIME_EXCESSIVE // Excessive overtime
  MISSING_TIMESHEET // Timesheet not submitted
}

enum PhotoRequirement {
  NONE // No photo required
  CLOCK_IN // Photo required on clock in only
  CLOCK_IN_OUT // Photo required on both clock in and out
}

enum OvertimeCalculationMode {
  DAILY // Overtime when any day exceeds threshold
  WEEKLY // Week total exceeds threshold
  MONTHLY // Month total exceeds threshold
