GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=CHANGE_ME
FROM_EMAIL=noreply@peoplecore.co.nz
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Optional Vercel KV or Upstash Redis credentials
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=your_kv_token
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Unified Audit System (Stage 1)
# Set to "true" to enable dual-write to legacy EmployeeAuditLog table
# Set to "false" to only write to GlobalAuditLog
UNIFIED_AUDIT_DUALWRITE=true
