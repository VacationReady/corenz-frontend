generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  BEREAVEMENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id             String           @id @default(uuid())
  name           String?          // <-- was required
  email          String           @unique
  emailVerified  DateTime?
  password       String?
  role           Role             @default(EMPLOYEE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  isActive       Boolean          @default(true)
  employee       Employee?
  activationToken ActivationToken?
  leaveRequests  LeaveRequest[]   @relation("LeaveRequestsByUser")
  reviewedLeaves LeaveRequest[]   @relation("LeaveRequestsReviewedByUser")
}

model Employee {
  id           String         @id @default(uuid())
  phone        String?
  department   String?
  jobTitle     String?
  startDate    DateTime?
  managerId    String?
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id])
  manager      Employee?      @relation("ManagerToEmployees", fields: [managerId], references: [id])
  subordinates Employee[]     @relation("ManagerToEmployees")
  leaveRequests LeaveRequest[] @relation("EmployeeLeaveRequests")
}

model ActivationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model LeaveRequest {
  id          String       @id @default(uuid())
  employeeId  String?      // <-- was required
  employee    Employee?    @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  type        LeaveType
  status      LeaveStatus  @default(PENDING)
  reason      String?      // <-- was required
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String
  user        User         @relation("LeaveRequestsByUser", fields: [userId], references: [id])
  reviewedBy  String?
  reviewer    User?        @relation("LeaveRequestsReviewedByUser", fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}
