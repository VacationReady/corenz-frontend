# ── Core required ──────────────────────────────────────────────────────────────
# Database connection string - NEVER commit real credentials
DATABASE_URL=postgresql://user:password@host:port/database

# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-generate-a-new-one

# NextAuth URL - your app's URL
NEXTAUTH_URL=http://localhost:3000

# Default email sender
FROM_EMAIL=noreply@yourdomain.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
HR_INBOX_EMAIL=hr@yourdomain.com

# ── Supabase storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-this
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Public app config ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAIN_PRODUCTION_COMPANY_ID=your-company-uuid

# ── OAuth providers (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# AZURE_AD_CLIENT_ID=...
# AZURE_AD_CLIENT_SECRET=...
# AZURE_AD_TENANT_ID=...

# ── Redis / KV (optional) ────────────────────────────────────────────────────
KV_REST_API_URL=https://your-upstash-url.upstash.io
KV_REST_API_TOKEN=your-upstash-token
KV_REST_API_READ_ONLY_TOKEN=your-read-only-token
KV_URL=rediss://default:token@your-upstash-url.upstash.io:6379
REDIS_URL=rediss://default:token@your-upstash-url.upstash.io:6379

# ── Rate limiting & feature toggles ──────────────────────────────────────────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
UNIFIED_AUDIT_DUALWRITE=true
PASSWORD_RESET_LIMIT=3
PASSWORD_RESET_WINDOW_MS=900000
TENANT_ADMIN_PASSWORD=change-this-to-a-strong-password
LOG_PRISMA=false

# ── Activation token settings ───────────────────────────────────────────────
# How long activation tokens are valid (in hours). Default: 72 hours (3 days)
ACTIVATION_TOKEN_EXPIRY_HOURS=72

# ── AI assistant ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
AI_RATE_LIMIT_REQUESTS=500
AI_RATE_LIMIT_WINDOW=3600000
DISABLE_AI_RATE_LIMIT=false
AI_DEBUG_MODE=false
LOG_AI_INTERACTIONS=false

# ── Workflow automation ─────────────────────────────────────────────────────
ENABLE_WORKFLOW_BUILDER=true
WORKFLOW_EXECUTION_TIMEOUT=300000
WORKFLOW_NODES=100
WORKFLOW_RETRY_ATTEMPTS=3
ENABLE_WORKFLOW_ANALYTICS=true

# ── Miscellaneous ───────────────────────────────────────────────────────────
ORIGIN_ALLOWLIST=https://your-production-domain.com,http://localhost:3000
NEXT_PUBLIC_API_URL=https://your-production-domain.com/
