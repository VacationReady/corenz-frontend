generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivationToken {
  id        String   @id
  token     String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model AutomationExecution {
  id             String                    @id
  ruleId         String
  companyId      String
  triggeredAt    DateTime                  @default(now())
  status         AutomationExecutionStatus
  triggerData    Json
  executionLog   Json?
  errorMessage   String?
  Company        Company                   @relation(fields: [companyId], references: [id])
  AutomationRule AutomationRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([ruleId, triggeredAt])
}

model AutomationJob {
  id             String              @id
  ruleId         String
  companyId      String
  triggerData    Json
  status         AutomationJobStatus @default(PENDING)
  priority       Int                 @default(0)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  scheduledAt    DateTime            @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  executionLog   Json?
  nextRetryAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime
  Company        Company             @relation(fields: [companyId], references: [id])
  AutomationRule AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([companyId, status, scheduledAt])
  @@index([ruleId])
  @@index([status, scheduledAt])
}

model AutomationRule {
  id                  String                @id
  companyId           String
  name                String
  description         String?
  isActive            Boolean               @default(false)
  triggerType         AutomationTriggerType
  triggerConfig       Json
  conditions          Json?
  actions             Json
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  createdBy           String
  AutomationExecution AutomationExecution[]
  AutomationJob       AutomationJob[]
  Company             Company               @relation(fields: [companyId], references: [id])
  User                User                  @relation(fields: [createdBy], references: [id])

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model BlackoutDay {
  id               String   @id
  date             DateTime
  companyId        String
  allEvents        Boolean  @default(false)
  eventCategoryIds String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  note             String?
}

model BrandingConfiguration {
  id                 String   @id
  companyId          String   @unique
  enabled            Boolean  @default(false)
  logoUrl            String?
  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  emailHeaderEnabled Boolean  @default(false)
  emailFooterEnabled Boolean  @default(false)
  emailFooterText    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  Company            Company  @relation(fields: [companyId], references: [id])
}

model Company {
  id                                  String                                @id
  name                                String                                @unique
  createdAt                           DateTime                              @default(now())
  updatedAt                           DateTime
  address                             String?
  code                                String?                               @unique
  industry                            String?
  phone                               String?
  size                                Int?
  website                             String?
  AutomationExecution                 AutomationExecution[]
  AutomationJob                       AutomationJob[]
  AutomationRule                      AutomationRule[]
  BrandingConfiguration               BrandingConfiguration?
  ContractTypeOption                  ContractTypeOption[]
  Department                          Department[]
  Document                            Document[]
  Employee                            Employee[]
  EmploymentTypeOption                EmploymentTypeOption[]
  EventCategory                       EventCategory[]
  EventRuleOverride                   EventRuleOverride[]
  EventSubcategory                    EventSubcategory[]
  Form                                Form[]
  GenderOption                        GenderOption[]
  GlobalAuditLog                      GlobalAuditLog[]
  JobRole                             JobRole[]
  LeaveEntitlement                    LeaveEntitlement[]
  LeavePolicy                         LeavePolicy[]
  LeavePolicyAssignment               LeavePolicyAssignment[]
  LeaveRequest                        LeaveRequest[]
  NotificationChannel                 NotificationChannel[]
  NotificationSettings                NotificationSettings?
  OnboardingNotificationPreference    OnboardingNotificationPreference[]
  OnboardingTemplate                  OnboardingTemplate[]
  PermissionProfile                   PermissionProfile[]
  SCIMConfiguration                   SCIMConfiguration?
  SSOConfiguration                    SSOConfiguration?
  SavedReport                         SavedReport[]
  TransactionalNotificationPreference TransactionalNotificationPreference[]
  User                                User[]
  WorkingPattern                      WorkingPattern[]
  // Added back-relations for tenant scoping added to models
  NewsPost                            NewsPost[]
  Location                            Location[]
  TrainingProvider                    TrainingProvider[]
  Course                              Course[]
  ExitInterviewFormTemplate           ExitInterviewFormTemplate[]
  ExpiryRule                          ExpiryRule[]
  EmployeePerformanceReview           EmployeePerformanceReview[]
  NewsReaction                        NewsReaction[]
  NewsBookmark                        NewsBookmark[]
  ApprovalWorkflow                    ApprovalWorkflow[]
}

model ContractTypeOption {
  id        String  @id
  companyId String
  label     String
  order     Int     @default(0)
  Company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, label])
  @@index([companyId, order])
}

model Course {
  id             String           @id
  name           String           @unique
  TrainingRecord TrainingRecord[]
  companyId      String?
  Company        Company?         @relation(fields: [companyId], references: [id])
}

model Department {
  id                                 String               @id
  name                               String
  companyId                          String
  active                             Boolean              @default(true)
  code                               String?
  createdAt                          DateTime             @default(now())
  description                        String?
  headId                             String?
  updatedAt                          DateTime
  Company                            Company              @relation(fields: [companyId], references: [id])
  User_Department_headIdToUser       User?                @relation("Department_headIdToUser", fields: [headId], references: [id])
  Employee                           Employee[]
  EventRuleOverride                  EventRuleOverride[]
  User_User_departmentIdToDepartment User[]               @relation("User_departmentIdToDepartment")
  Document                           Document[]           @relation("DocumentDepartments")
  OnboardingTemplate                 OnboardingTemplate[] @relation("OnboardingTemplateDepartments")

  @@unique([companyId, name])
  @@unique([companyId, code])
}

model Document {
  id                        String                    @id
  name                      String
  category                  String?
  path                      String
  size                      Int
  type                      String
  uploaderId                String
  companyId                 String
  createdAt                 DateTime                  @default(now())
  deletedAt                 DateTime?
  url                       String
  employeeId                String?
  description               String?
  canViewAdmin              Boolean                   @default(true)
  canViewEmployee           Boolean                   @default(true)
  canViewManager            Boolean                   @default(false)
  requiresAck               Boolean                   @default(false)
  requireAckFromNewStarters Boolean                   @default(false)
  Company                   Company                   @relation(fields: [companyId], references: [id])
  Employee                  Employee?                 @relation(fields: [employeeId], references: [id])
  User                      User                      @relation(fields: [uploaderId], references: [id])
  DocumentAcknowledgement   DocumentAcknowledgement[]
  DriverLicence             DriverLicence[]
  OnboardingStep            OnboardingStep[]
  TrainingRecord            TrainingRecord[]
  Department                Department[]              @relation("DocumentDepartments")
  JobRole                   JobRole[]                 @relation("DocumentJobRoles")
}

model DocumentAcknowledgement {
  id                String           @id
  documentId        String
  employeeId        String
  acknowledgedAt    DateTime         @default(now())
  employmentCheckId String?
  Document          Document         @relation(fields: [documentId], references: [id])
  Employee          Employee         @relation(fields: [employeeId], references: [id])
  EmploymentCheck   EmploymentCheck? @relation(fields: [employmentCheckId], references: [id])

  @@unique([documentId, employeeId])
}

model DriverLicence {
  id            String    @id
  employeeId    String
  type          String
  licenceNumber String
  issueDate     DateTime
  expiryDate    DateTime
  documentId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Document      Document? @relation(fields: [documentId], references: [id])
  Employee      Employee  @relation(fields: [employeeId], references: [id])
}

model EmergencyContact {
  id           String   @id
  employeeId   String
  name         String
  relationship String?
  phone        String?
  email        String?
  Employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Employee {
  id                               String                             @id
  userId                           String                             @unique
  isActive                         Boolean                            @default(true)
  workingPatternId                 String?
  departmentId                     String?
  jobRoleId                        String?
  onboardingStatus                 Json?
  onboardingTemplateId             String?
  companyId                        String
  offboardingStatus                String?
  offboardingDate                  DateTime?
  lastWorkingDate                  DateTime?
  noticePeriodDays                 Int?
  offboardingReason                String?
  offboardingNotes                 String?
  locationId                       String?
  startDate                        DateTime?
  bankAccountNumber                String?
  contractType                     String?
  employmentType                   String?
  hourlyRate                       Decimal?                           @db.Decimal(10, 2)
  kiwiSaverContribution            Int?
  kiwiSaverEnrolled                Boolean?
  salaryAmount                     Decimal?                           @db.Decimal(10, 2)
  siteLocation                     String?
  taxCode                          String?
  Document                         Document[]
  DocumentAcknowledgement          DocumentAcknowledgement[]
  DriverLicence                    DriverLicence[]
  EmergencyContact                 EmergencyContact[]
  Company                          Company                            @relation(fields: [companyId], references: [id])
  Department                       Department?                        @relation(fields: [departmentId], references: [id])
  JobRole                          JobRole?                           @relation(fields: [jobRoleId], references: [id])
  OnboardingTemplate               OnboardingTemplate?                @relation(fields: [onboardingTemplateId], references: [id])
  User                             User                               @relation(fields: [userId], references: [id])
  WorkingPattern                   WorkingPattern?                    @relation(fields: [workingPatternId], references: [id])
  EmployeeOffboarding              EmployeeOffboarding?
  EmployeeWorkingPatternAssignment EmployeeWorkingPatternAssignment[]
  EmploymentCheck                  EmploymentCheck[]
  FormAssignment                   FormAssignment[]
  FormDataRecord                   FormDataRecord[]
  FormSubmission                   FormSubmission[]
  LeaveEntitlement                 LeaveEntitlement[]
  LeaveRequest                     LeaveRequest[]
  OnboardingInstance               OnboardingInstance[]
  TrainingRecord                   TrainingRecord[]
  EmployeeAuditLog                 EmployeeAuditLog[]
  PerformanceReviews               EmployeePerformanceReview[]
}

model EmployeePerformanceReview {
  id                     String    @id
  employeeId             String
  companyId              String
  reviewerId             String?
  reviewDate             DateTime
  rating                 Int?
  summary                String?
  strengths              String?
  areasForImprovement    String?
  goals                  Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  Employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Company                Company   @relation(fields: [companyId], references: [id])
  Reviewer               User?     @relation("EmployeePerformanceReviewReviewer", fields: [reviewerId], references: [id])

  @@index([employeeId, reviewDate])
  @@index([companyId])
}

model EmployeeOffboarding {
  id                                                 String                        @id
  employeeId                                         String                        @unique
  initiatedById                                      String
  initiatedAt                                        DateTime                      @default(now())
  completedAt                                        DateTime?
  resignationDate                                    DateTime?
  lastWorkingDate                                    DateTime
  noticePeriodDays                                   Int?
  actualLeaveDate                                    DateTime?
  offboardingReason                                  String?
  isVoluntary                                        Boolean                       @default(true)
  removeAccessImmediately                            Boolean                       @default(false)
  accessRemovedAt                                    DateTime?
  accessRemovedBy                                    String?
  assetsToReturn                                     Json?
  assetsReturned                                     Boolean                       @default(false)
  assetsReturnedAt                                   DateTime?
  assetsReturnedTo                                   String?
  handoverRequired                                   Boolean                       @default(false)
  handoverAssignedTo                                 String?
  handoverCompleted                                  Boolean                       @default(false)
  handoverCompletedAt                                DateTime?
  handoverNotes                                      String?
  finalPayCalculated                                 Boolean                       @default(false)
  finalPayAmount                                     Decimal?                      @db.Decimal(10, 2)
  unusedLeaveHours                                   Decimal?                      @db.Decimal(8, 2)
  unusedLeavePayment                                 Decimal?                      @db.Decimal(10, 2)
  benefitsEndDate                                    DateTime?
  exitInterviewRequired                              Boolean                       @default(false)
  exitInterviewScheduled                             Boolean                       @default(false)
  exitInterviewNotes                                 String?
  hrReviewRequired                                   Boolean                       @default(true)
  hrReviewCompleted                                  Boolean                       @default(false)
  hrReviewCompletedBy                                String?
  hrReviewCompletedAt                                DateTime?
  hrNotes                                            String?
  referenceContactAllowed                            Boolean                       @default(true)
  documentationArchived                              Boolean                       @default(false)
  complianceCheckCompleted                           Boolean                       @default(false)
  createdAt                                          DateTime                      @default(now())
  updatedAt                                          DateTime
  exitInterviewDate                                  DateTime?
  exitInterviewEnd                                   DateTime?
  interviewerUserId                                  String?
  interviewerName                                    String?
  interviewerEmail                                   String?
  location                                           String?
  sendForm                                           Boolean                       @default(false)
  formTemplateId                                     String?
  inviteIcsUid                                       String?
  inviteLastSentAt                                   DateTime?
  scheduledSendAt                                    DateTime?
  completionTokenHash                                String?
  status                                             OffboardingStatus             @default(IN_PROGRESS)
  offboardingType                                    OffboardingType
  formTiming                                         ExitInterviewFormTiming?
  completionStatus                                   ExitInterviewCompletionStatus @default(PENDING)
  User_EmployeeOffboarding_accessRemovedByToUser     User?                         @relation("EmployeeOffboarding_accessRemovedByToUser", fields: [accessRemovedBy], references: [id])
  User_EmployeeOffboarding_assetsReturnedToToUser    User?                         @relation("EmployeeOffboarding_assetsReturnedToToUser", fields: [assetsReturnedTo], references: [id])
  Employee                                           Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ExitInterviewFormTemplate                          ExitInterviewFormTemplate?    @relation(fields: [formTemplateId], references: [id])
  User_EmployeeOffboarding_handoverAssignedToToUser  User?                         @relation("EmployeeOffboarding_handoverAssignedToToUser", fields: [handoverAssignedTo], references: [id])
  User_EmployeeOffboarding_hrReviewCompletedByToUser User?                         @relation("EmployeeOffboarding_hrReviewCompletedByToUser", fields: [hrReviewCompletedBy], references: [id])
  User_EmployeeOffboarding_initiatedByIdToUser       User                          @relation("EmployeeOffboarding_initiatedByIdToUser", fields: [initiatedById], references: [id])
  User_EmployeeOffboarding_interviewerUserIdToUser   User?                         @relation("EmployeeOffboarding_interviewerUserIdToUser", fields: [interviewerUserId], references: [id])
  ExitInterview                                      ExitInterview?
  ExitInterviewSubmission                            ExitInterviewSubmission[]
  OffboardingTask                                    OffboardingTask[]

  @@index([employeeId])
  @@index([exitInterviewDate])
  @@index([lastWorkingDate])
  @@index([scheduledSendAt])
  @@index([status])
}

model EmployeeWorkingPatternAssignment {
  id               String         @id
  employeeId       String
  workingPatternId String
  effectiveDate    DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  Employee         Employee       @relation(fields: [employeeId], references: [id])
  WorkingPattern   WorkingPattern @relation(fields: [workingPatternId], references: [id])

  @@index([employeeId, effectiveDate])
}

model EmploymentCheck {
  id                      String                    @id
  employeeId              String
  typeOfCheck             String
  documentNumber          String
  dateOfIssue             DateTime
  expiryDate              DateTime
  documentUrl             String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  DocumentAcknowledgement DocumentAcknowledgement[]
  Employee                Employee                  @relation(fields: [employeeId], references: [id])
}

model EmploymentTypeOption {
  id        String  @id
  companyId String
  label     String
  order     Int     @default(0)
  Company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, label])
  @@index([companyId, order])
}

model EventCategory {
  id                String              @id
  name              String
  requiresApproval  Boolean
  adminOnly         Boolean
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  categoryType      String
  color             String?
  systemDefined     Boolean             @default(false)
  companyId         String
  Company           Company             @relation(fields: [companyId], references: [id])
  EventRule         EventRule[]
  EventRuleOverride EventRuleOverride[]
  EventSubcategory  EventSubcategory[]
  LeaveEntitlement  LeaveEntitlement[]
  LeavePolicy       LeavePolicy[]
  LeaveRequest      LeaveRequest[]
  ApprovalWorkflow  ApprovalWorkflow[]

  @@unique([companyId, name])
}

model EventRule {
  id                    String          @id
  companyId             String
  eventCategoryId       String
  enforceEntitlement    Boolean         @default(true)
  noticePeriodDays      Int             @default(0)
  maxConcurrent         Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime
  maxBookingLength      Int?
  maxCarryoverDays      Int?
  carryoverExpiryMonths Int?
  maxBookingLengthMode  EnforcementMode @default(HARD_BLOCK)
  maxConcurrentMode     EnforcementMode @default(HARD_BLOCK)
  notes                 String?
  EventCategory         EventCategory   @relation(fields: [eventCategoryId], references: [id])

  @@unique([companyId, eventCategoryId])
}

model EventRuleOverride {
  id                       String                  @id
  companyId                String
  eventCategoryId          String
  departmentId             String?
  teamId                   String?
  enforceEntitlement       Boolean?
  noticePeriodDays         Int?
  maxConcurrent            Int?
  maxBookingLength         Int?
  maxConcurrentMode        EnforcementMode?
  maxBookingLengthMode     EnforcementMode?
  staffingDensityEnabled   Boolean                 @default(false)
  staffingDensityThreshold Float?
  staffingDensityBehavior  StaffingDensityBehavior @default(DENY)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime
  Company                  Company                 @relation(fields: [companyId], references: [id])
  Department               Department?             @relation(fields: [departmentId], references: [id])
  EventCategory            EventCategory           @relation(fields: [eventCategoryId], references: [id])

  @@unique([companyId, eventCategoryId, departmentId, teamId])
  @@index([companyId, eventCategoryId])
}

model EventSubcategory {
  id                String         @id
  name              String
  eventCategoryId   String
  defaultPaidStatus PaidStatus     @default(PAID)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  companyId         String
  Company           Company        @relation(fields: [companyId], references: [id])
  EventCategory     EventCategory  @relation(fields: [eventCategoryId], references: [id])
  LeaveRequest      LeaveRequest[]

  @@unique([companyId, name])
}

model ExitInterview {
  id                  String              @id
  offboardingId       String              @unique
  scheduledAt         DateTime?
  interviewerId       String?
  location            String?
  notes               String?
  completed           Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  EmployeeOffboarding EmployeeOffboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)

  @@index([offboardingId])
}

model ExitInterviewFormTemplate {
  id                      String                    @id
  name                    String
  description             String?
  schemaJson              Json
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  EmployeeOffboarding     EmployeeOffboarding[]
  ExitInterviewSubmission ExitInterviewSubmission[]
  companyId               String?
  Company                 Company?                  @relation(fields: [companyId], references: [id])

  @@index([isActive])
}

model ExitInterviewSubmission {
  id                        String                    @id
  offboardingId             String
  templateId                String
  submittedBy               String?
  submittedAt               DateTime?
  answersJson               Json?
  EmployeeOffboarding       EmployeeOffboarding       @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  ExitInterviewFormTemplate ExitInterviewFormTemplate @relation(fields: [templateId], references: [id])

  @@index([offboardingId])
  @@index([templateId])
}

model ExpiryRule {
  id             String   @id
  category       String   @unique
  daysBefore     Int
  notifyAdmin    Boolean  @default(true)
  notifyManager  Boolean  @default(true)
  notifyEmployee Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  companyId      String?
  Company        Company? @relation(fields: [companyId], references: [id])
}

model FieldMetadata {
  id           String   @id
  model        String
  field        String
  label        String
  fieldType    String
  isReportable Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Form {
  id                   String           @id
  companyId            String
  name                 String
  description          String?
  schema               Json
  version              Int              @default(1)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  visibleToDepartments String[]         @default([])
  visibleToJobRoles    String[]         @default([])
  slug                 String
  formType             FormType         @default(SUBMISSION)
  visibleToRoles       String[]         @default([])
  Company              Company          @relation(fields: [companyId], references: [id])
  FormAssignment       FormAssignment[]
  FormDataRecord       FormDataRecord[]
  FormSubmission       FormSubmission[]
  OnboardingStep       OnboardingStep[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
}

model FormAssignment {
  id           String    @id
  formId       String
  employeeId   String
  assignedById String
  dueDate      DateTime?
  status       String    @default("pending")
  completedAt  DateTime?
  User         User      @relation(fields: [assignedById], references: [id])
  Employee     Employee  @relation(fields: [employeeId], references: [id])
  Form         Form      @relation(fields: [formId], references: [id])
}

model FormDataRecord {
  id         String   @id
  formId     String
  employeeId String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Employee   Employee @relation(fields: [employeeId], references: [id])
  Form       Form     @relation(fields: [formId], references: [id])

  @@unique([formId, employeeId])
}

model FormSubmission {
  id          String   @id
  formId      String
  employeeId  String
  data        Json
  submittedAt DateTime @default(now())
  Employee    Employee @relation(fields: [employeeId], references: [id])
  Form        Form     @relation(fields: [formId], references: [id])
}

model GenderOption {
  id        String   @id
  companyId String
  key       String
  label     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Company   Company  @relation(fields: [companyId], references: [id])
  User      User[]

  @@unique([companyId, key])
  @@index([companyId, active])
}

model GlobalAuditLog {
  id         String          @id
  companyId  String
  entityType AuditEntityType
  entityId   String
  action     AuditAction
  actorId    String
  actorType  AuditActorType  @default(USER)
  changes    Json?
  metadata   Json?
  timestamp  DateTime        @default(now())
  User       User            @relation(fields: [actorId], references: [id])
  Company    Company         @relation(fields: [companyId], references: [id])

  @@index([companyId, actorId])
  @@index([companyId, entityType, entityId])
  @@index([companyId, timestamp])
}

model JobRole {
  id                 String               @id
  name               String
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  description        String?
  level              Int?
  payGrade           String?
  updatedAt          DateTime
  companyId          String
  Employee           Employee[]
  Company            Company              @relation(fields: [companyId], references: [id])
  User               User[]
  Document           Document[]           @relation("DocumentJobRoles")
  OnboardingTemplate OnboardingTemplate[] @relation("OnboardingTemplateJobRoles")

  @@unique([companyId, name])
}

model LeaveEntitlement {
  id              String        @id
  employeeId      String
  createdAt       DateTime      @default(now())
  totalDays       Float
  updatedAt       DateTime
  usedDays        Float
  daysAllocated   Float         @default(0)
  eventCategoryId String
  carryoverDays   Float         @default(0)
  carryoverExpiry DateTime?
  companyId       String
  Company         Company       @relation(fields: [companyId], references: [id])
  Employee        Employee      @relation(fields: [employeeId], references: [id])
  EventCategory   EventCategory @relation(fields: [eventCategoryId], references: [id])

  @@unique([employeeId, eventCategoryId])
}

model LeavePolicy {
  id                    String                  @id
  companyId             String
  name                  String
  description           String?
  eventCategoryId       String
  isActive              Boolean                 @default(true)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  accrualRate           Float
  accrualPeriod         AccrualPeriod           @default(MONTHLY)
  accrualUnit           AccrualUnit             @default(DAYS)
  enableProration       Boolean                 @default(true)
  prorationMethod       ProrationMethod         @default(DAILY)
  serviceLengthTiers    Json?
  allowNegativeBalance  Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  Company               Company                 @relation(fields: [companyId], references: [id])
  EventCategory         EventCategory           @relation(fields: [eventCategoryId], references: [id])
  LeavePolicyAssignment LeavePolicyAssignment[]

  @@unique([companyId, name])
  @@index([companyId, eventCategoryId])
  @@index([effectiveFrom, effectiveTo])
}

model LeavePolicyAssignment {
  id            String      @id
  leavePolicyId String
  companyId     String
  departmentIds String[]    @default([])
  jobRoleIds    String[]    @default([])
  locationIds   String[]    @default([])
  employeeIds   String[]    @default([])
  priority      Int         @default(0)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  Company       Company     @relation(fields: [companyId], references: [id])
  LeavePolicy   LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([effectiveFrom, effectiveTo])
}

model LeaveRequest {
  id                                   String            @id
  startDate                            DateTime
  endDate                              DateTime
  createdAt                            DateTime          @default(now())
  updatedAt                            DateTime
  employeeId                           String
  reason                               String?
  approvalStatus                       ApprovalStatus    @default(PENDING)
  approvedById                         String?
  sickReasonId                         String?
