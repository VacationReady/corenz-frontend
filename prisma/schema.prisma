// Existing generator and datasource remain unchanged

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum LeaveType {
  ANNUAL
  SICK
  BEREAVEMENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  emailVerified   DateTime?
  password        String
  role            Role
  name            String?
  phone           String?
  firstName       String?
  lastName        String?
  isActivated     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  managerId       String?
  manager         User?            @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates    User[]           @relation("ManagerSubordinates")
  jobRoleId       String?
  jobRole         JobRole?         @relation(fields: [jobRoleId], references: [id])
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  employee        Employee?
  activationToken ActivationToken?

  // Named leave request relations
  leaveRequestsToReview LeaveRequest[] @relation("ReviewedByUser")
  leaveRequestsCreated  LeaveRequest[] @relation("RequestingUser")
}

model ActivationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Employee {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id])
  isActive          Boolean           @default(true)
  leaveRequests     LeaveRequest[]
  leaveEntitlements LeaveEntitlement[]

  // NEW: Working Pattern
  workingPatternId  String?
  workingPattern    WorkingPattern?   @relation(fields: [workingPatternId], references: [id])
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

model JobRole {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

model LeaveRequest {
  id              String          @id @default(cuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id])
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  reason          String?
  approvalStatus  ApprovalStatus  @default(PENDING)
  approvedById    String?
  approvedBy      User?           @relation("ReviewedByUser", fields: [approvedById], references: [id])
  createdById     String
  createdBy       User            @relation("RequestingUser", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model LeaveEntitlement {
  id             String      @id @default(cuid())
  employee       Employee    @relation(fields: [employeeId], references: [id])
  employeeId     String
  leaveType      LeaveType
  totalDays      Float       // using Float for future partial support
  usedDays       Float       // using Float for future partial support
  daysAllocated  Float       @default(0) // using Float to match
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// NEW: Working Pattern Model

model WorkingPattern {
  id          String     @id @default(cuid())
  name        String
  description String?
  workingDays String[]   // e.g., ["Mon", "Tue", "Wed", "Thu", "Fri"]
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employees   Employee[]

  @@index([active])
}
