generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                           String                 @id @default(cuid())
  email                                        String
  password                                     String
  role                                         Role                   @default(EMPLOYEE)
  permissionProfileId                          String?
  createdAt                                    DateTime               @default(now())
  updatedAt                                    DateTime               @updatedAt
  emailVerified                                DateTime?
  name                                         String?
  departmentId                                 String?
  firstName                                    String?
  isActivated                                  Boolean                @default(false)
  jobRoleId                                    String?
  lastName                                     String?
  managerId                                    String?
  phone                                        String?
  dateOfBirth                                  DateTime?
  companyId                                    String
  emailPreferences                             Json?
  profileImageUrl                              String?
  // Personal info (extended)
  addressStreet                                String?
  addressCity                                  String?
  addressPostcode                              String?
  addressCountry                               String?
  emergencyContactName                         String?
  emergencyContactRelationship                 String?
  emergencyContactPhone                        String?
  nationalId                                   String?
  residencyStatus                              String?
  pronouns                                     String?
  genderOptionId                               String?
  activationToken                              ActivationToken?
  departmentHeadOf                             Department[]           @relation("DepartmentHead")
  documents                                    Document[]
  employee                                     Employee?
  assignedForms                                FormAssignment[]       @relation("AssignedForms")
  LeaveRequest_LeaveRequest_approvedByIdToUser LeaveRequest[]         @relation("LeaveRequest_approvedByIdToUser")
  leaveRequestsRequested                       LeaveRequest[]         @relation("RequestingUser")
  newsPosts                                    NewsPost[]
  onboardingAssignments                        OnboardingAssignment[]
  SavedReport                                  SavedReport[]
  updatedTemplates                             OnboardingTemplate[]   @relation("OnboardingTemplateUpdatedBy")

  // Offboarding relations
  offboardingInitiated         EmployeeOffboarding[] @relation("OffboardingInitiatedBy")
  offboardingAccessRemoved     EmployeeOffboarding[] @relation("OffboardingAccessRemovedBy")
  offboardingHandoverAssigned  EmployeeOffboarding[] @relation("OffboardingHandoverAssignedTo")
  offboardingHRReviewCompleted EmployeeOffboarding[] @relation("OffboardingHRReviewCompletedBy")
  offboardingAssetsReturnedTo  EmployeeOffboarding[] @relation("OffboardingAssetsReturnedTo")
  exitInterviewConducted       EmployeeOffboarding[] @relation("ExitInterviewInterviewer")
  tasksAssigned                OffboardingTask[]     @relation("TaskAssignedTo")
  tasksCompleted               OffboardingTask[]     @relation("TaskCompletedBy")

  // Permission relations
  permissionAuditChanges   PermissionAudit[] @relation("PermissionAuditChangedBy")
  permissionAuditEmployees PermissionAudit[] @relation("PermissionAuditEmployee")

  // Personal info audit relations
  personalInfoAuditsAsSubject PersonalInfoAudit[] @relation("PersonalInfoAuditSubjectUser")
  personalInfoAuditsChangedBy PersonalInfoAudit[] @relation("PersonalInfoAuditChangedBy")

  // New HR product feature relations
  automationRulesCreated AutomationRule[] @relation("AutomationRuleCreator")
  globalAuditLogsAsActor GlobalAuditLog[] @relation("GlobalAuditLogActor")

  // Gender option relation
  genderOption GenderOption? @relation(fields: [genderOptionId], references: [id])

  company           Company            @relation(fields: [companyId], references: [id])
  department        Department?        @relation(fields: [departmentId], references: [id])
  jobRole           JobRole?           @relation(fields: [jobRoleId], references: [id])
  manager           User?              @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates      User[]             @relation("ManagerSubordinates")
  permissionProfile PermissionProfile? @relation(fields: [permissionProfileId], references: [id])

  @@unique([email, companyId])
}

model ActivationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Employee {
  id                   String    @id @default(cuid())
  userId               String    @unique
  isActive             Boolean   @default(true)
  workingPatternId     String?
  departmentId         String?
  jobRoleId            String?
  locationId           String? // For Leave Policy assignments
  startDate            DateTime? // For service-length tier calculations
  onboardingStatus     Json?
  onboardingTemplateId String?
  companyId            String // <-- Added companyId column

  // Offboarding fields
  offboardingStatus String?
  offboardingDate   DateTime?
  lastWorkingDate   DateTime?
  noticePeriodDays  Int?
  offboardingReason String?
  offboardingNotes  String?

  company Company @relation(fields: [companyId], references: [id]) // <-- Relation

  Document                  Document[]
  DocumentAcknowledgement   DocumentAcknowledgement[]
  driverLicences            DriverLicence[]
  department                Department?                        @relation(fields: [departmentId], references: [id])
  jobRole                   JobRole?                           @relation(fields: [jobRoleId], references: [id])
  onboardingTemplate        OnboardingTemplate?                @relation("OnboardingTemplateEmployees", fields: [onboardingTemplateId], references: [id])
  user                      User                               @relation(fields: [userId], references: [id])
  workingPattern            WorkingPattern?                    @relation(fields: [workingPatternId], references: [id])
  workingPatternAssignments EmployeeWorkingPatternAssignment[]
  employmentChecks          EmploymentCheck[]
  formAssignments           FormAssignment[]
  formSubmissions           FormSubmission[]
  formDataRecords           FormDataRecord[] // NEW: Persistent form data
  leaveEntitlements         LeaveEntitlement[]
  leaveRequests             LeaveRequest[]
  onboardingInstances       OnboardingInstance[]
  trainingRecords           TrainingRecord[]
  offboardingRecord         EmployeeOffboarding?
  emergencyContacts         EmergencyContact[]

  // Payroll & Employment
  bankAccountNumber     String?
  taxCode               String?
  kiwiSaverEnrolled     Boolean?
  kiwiSaverContribution Int?
  employmentType        String?
  contractType          String?
  siteLocation          String?
  salaryAmount          Decimal? @db.Decimal(10, 2)
  hourlyRate            Decimal? @db.Decimal(10, 2)
}

model EmergencyContact {
  id           String  @id @default(cuid())
  employeeId   String
  name         String
  relationship String?
  phone        String?
  email        String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeWorkingPatternAssignment {
  id               String         @id @default(cuid())
  employeeId       String
  workingPatternId String
  effectiveDate    DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  employee         Employee       @relation(fields: [employeeId], references: [id])
  workingPattern   WorkingPattern @relation(fields: [workingPatternId], references: [id])

  @@index([employeeId, effectiveDate])
}

model EventCategory {
  id                 String              @id @default(cuid())
  name               String
  requiresApproval   Boolean
  adminOnly          Boolean
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  categoryType       String
  color              String?
  systemDefined      Boolean             @default(false)
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  eventRules         EventRule[]
  subcategories      EventSubcategory[]
  LeaveEntitlement   LeaveEntitlement[]
  leaveRequests      LeaveRequest[]
  leavePolicies      LeavePolicy[]
  eventRuleOverrides EventRuleOverride[]

  @@unique([companyId, name])
}

model EventSubcategory {
  id                String         @id @default(cuid())
  name              String
  eventCategoryId   String
  companyId         String
  defaultPaidStatus PaidStatus     @default(PAID)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  eventCategory     EventCategory  @relation(fields: [eventCategoryId], references: [id])
  company           Company        @relation(fields: [companyId], references: [id])
  LeaveRequest      LeaveRequest[]

  @@unique([companyId, name])
}

model LeaveRequest {
  id               String            @id @default(cuid())
  startDate        DateTime
  endDate          DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  employeeId       String
  reason           String?
  approvalStatus   ApprovalStatus    @default(PENDING)
  approvedById     String?
  sickReasonId     String?
  paidStatus       PaidStatus?
  dayType          DayType
  eventCategoryId  String
  requesterId      String
  companyId        String
  approvedBy       User?             @relation("LeaveRequest_approvedByIdToUser", fields: [approvedById], references: [id])
  employee         Employee          @relation(fields: [employeeId], references: [id])
  eventCategory    EventCategory     @relation(fields: [eventCategoryId], references: [id])
  requester        User              @relation("RequestingUser", fields: [requesterId], references: [id])
  EventSubcategory EventSubcategory? @relation(fields: [sickReasonId], references: [id])
  company          Company           @relation(fields: [companyId], references: [id])
}

model LeaveEntitlement {
  id              String        @id @default(cuid())
  employeeId      String
  createdAt       DateTime      @default(now())
  totalDays       Float
  updatedAt       DateTime      @updatedAt
  usedDays        Float
  daysAllocated   Float         @default(0)
  eventCategoryId String
  carryoverDays   Float         @default(0)
  carryoverExpiry DateTime?
  companyId       String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  eventCategory   EventCategory @relation(fields: [eventCategoryId], references: [id])
  company         Company       @relation(fields: [companyId], references: [id])

  @@unique([employeeId, eventCategoryId])
}

model Department {
  id                  String               @id @default(cuid())
  name                String
  companyId           String
  active              Boolean              @default(true)
  code                String?              @unique
  createdAt           DateTime             @default(now())
  description         String?
  headId              String?
  updatedAt           DateTime             @updatedAt
  company             Company              @relation(fields: [companyId], references: [id])
  head                User?                @relation("DepartmentHead", fields: [headId], references: [id])
  employees           Employee[]
  users               User[]
  documents           Document[]           @relation("DocumentDepartments")
  onboardingTemplates OnboardingTemplate[] @relation("OnboardingTemplateDepartments")
  eventRuleOverrides  EventRuleOverride[]

  @@unique([companyId, name])
}

model Company {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  address                String?
  code                   String?                 @unique
  industry               String?
  phone                  String?
  size                   Int?
  website                String?
  departments            Department[]
  documents              Document[]
  forms                  Form[]
  jobRoles               JobRole[]
  onboardingTemplates    OnboardingTemplate[]
  SavedReport            SavedReport[]
  users                  User[]
  employees              Employee[]
  permissionProfiles     PermissionProfile[]
  genderOptions          GenderOption[]
  workingPatterns        WorkingPattern[]
  locations              Location[]
  eventCategories        EventCategory[]
  eventSubcategories     EventSubcategory[]
  leaveRequests          LeaveRequest[]
  leaveEntitlements      LeaveEntitlement[]
  leavePolicies          LeavePolicy[]
  leavePolicyAssignments LeavePolicyAssignment[]

  // New HR product feature relations
  automationRules       AutomationRule[]
  automationExecutions  AutomationExecution[]
  automationJobs        AutomationJob[]
  eventRuleOverrides    EventRuleOverride[]
  globalAuditLogs       GlobalAuditLog[]
  notificationChannels  NotificationChannel[]
  notificationSettings  NotificationSettings?
  ssoConfiguration      SSOConfiguration?
  scimConfiguration     SCIMConfiguration?
  brandingConfiguration BrandingConfiguration?
  employmentTypeOptions EmploymentTypeOption[]
  contractTypeOptions   ContractTypeOption[]
}

model EmploymentTypeOption {
  id        String @id @default(cuid())
  companyId String
  label     String
  order     Int    @default(0)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, label])
  @@index([companyId, order])
}

model ContractTypeOption {
  id        String @id @default(cuid())
  companyId String
  label     String
  order     Int    @default(0)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, label])
  @@index([companyId, order])
}

model JobRole {
  id                  String               @id @default(cuid())
  name                String
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  description         String?
  level               Int?
  payGrade            String?
  updatedAt           DateTime             @updatedAt
  companyId           String
  employees           Employee[]
  company             Company              @relation(fields: [companyId], references: [id])
  users               User[]
  documents           Document[]           @relation("DocumentJobRoles")
  onboardingTemplates OnboardingTemplate[] @relation("OnboardingTemplateJobRoles")

  @@unique([companyId, name])
}

model WorkingPattern {
  id                 String                             @id @default(cuid())
  name               String
  active             Boolean                            @default(true)
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  description        String?
  companyId          String
  company            Company                            @relation(fields: [companyId], references: [id])
  employees          Employee[]
  assignments        EmployeeWorkingPatternAssignment[]
  WorkingPatternWeek WorkingPatternWeek[]
}

model WorkingPatternDay {
  id                   String             @id @default(cuid())
  day                  String
  type                 DayType
  workingPatternWeekId String
  WorkingPatternWeek   WorkingPatternWeek @relation(fields: [workingPatternWeekId], references: [id], onDelete: Cascade)

  @@unique([day, workingPatternWeekId])
}

model WorkingPatternWeek {
  id                String              @id @default(cuid())
  weekNumber        Int
  workingPatternId  String
  WorkingPatternDay WorkingPatternDay[]
  WorkingPattern    WorkingPattern      @relation(fields: [workingPatternId], references: [id], onDelete: Cascade)

  @@unique([weekNumber, workingPatternId])
}

model EventRule {
  id                    String          @id @default(cuid())
  companyId             String
  eventCategoryId       String
  enforceEntitlement    Boolean         @default(true)
  noticePeriodDays      Int             @default(0)
  maxConcurrent         Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  maxBookingLength      Int?
  maxCarryoverDays      Int?
  carryoverExpiryMonths Int?
  // Enforcement mode toggles - NEW
  maxConcurrentMode     EnforcementMode @default(HARD_BLOCK)
  maxBookingLengthMode  EnforcementMode @default(HARD_BLOCK)
  // Help/Notes - NEW
  notes                 String?
  eventCategory         EventCategory   @relation(fields: [eventCategoryId], references: [id])

  @@unique([companyId, eventCategoryId])
}

// Leave Policies - Accrual Engine Only
model LeavePolicy {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  description     String?
  eventCategoryId String
  isActive        Boolean   @default(true)
  effectiveFrom   DateTime
  effectiveTo     DateTime?

  // Accrual Configuration
  accrualRate   Float // days/hours per period
  accrualPeriod AccrualPeriod @default(MONTHLY)
  accrualUnit   AccrualUnit   @default(DAYS)

  // Proration Rules
  enableProration Boolean         @default(true)
  prorationMethod ProrationMethod @default(DAILY)

  // Service-length tiers
  serviceLengthTiers Json? // Array of { minYears: number, maxYears?: number, accrualRate: number }

  // Negative balance
  allowNegativeBalance Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company                 @relation(fields: [companyId], references: [id])
  eventCategory EventCategory           @relation(fields: [eventCategoryId], references: [id])
  assignments   LeavePolicyAssignment[]

  @@unique([companyId, name])
  @@index([companyId, eventCategoryId])
  @@index([effectiveFrom, effectiveTo])
}

// Leave Policy Assignments
model LeavePolicyAssignment {
  id            String @id @default(cuid())
  leavePolicyId String
  companyId     String

  // Assignment targets (at least one must be specified)
  departmentIds String[] @default([])
  jobRoleIds    String[] @default([])
  locationIds   String[] @default([])
  employeeIds   String[] @default([]) // Specific employee overrides

  // Priority for overlapping assignments (higher = more specific)
  priority Int @default(0)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([effectiveFrom, effectiveTo])
}

model BlackoutDay {
  id               String   @id @default(cuid())
  date             DateTime
  companyId        String
  allEvents        Boolean  @default(false)
  eventCategoryIds String[]
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FieldMetadata {
  id           String   @id @default(cuid())
  model        String
  field        String
  label        String
  fieldType    String
  isReportable Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model SavedReport {
  name        String
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    String
  createdBy   String
  id          Int      @id @default(autoincrement())
  description String?
  filters     Json?
  pagination  Json?
  sort        Json?
  fields      String[]
  Company     Company  @relation(fields: [companyId], references: [id])
  user        User     @relation(fields: [createdBy], references: [id])

  @@unique([name, companyId])
}

model Document {
  id                        String                    @id @default(cuid())
  name                      String
  category                  String?
  path                      String
  size                      Int
  type                      String
  uploaderId                String
  companyId                 String
  createdAt                 DateTime                  @default(now())
  deletedAt                 DateTime?
  url                       String
  employeeId                String?
  description               String?
  canViewAdmin              Boolean                   @default(true)
  canViewEmployee           Boolean                   @default(true)
  canViewManager            Boolean                   @default(false)
  requiresAck               Boolean                   @default(false)
  requireAckFromNewStarters Boolean                   @default(false)
  company                   Company                   @relation(fields: [companyId], references: [id])
  employee                  Employee?                 @relation(fields: [employeeId], references: [id])
  uploader                  User                      @relation(fields: [uploaderId], references: [id])
  acknowledgements          DocumentAcknowledgement[]
  driverLicences            DriverLicence[]
  onboardingSteps           OnboardingStep[]
  trainingRecords           TrainingRecord[]
  departments               Department[]              @relation("DocumentDepartments")
  jobRoles                  JobRole[]                 @relation("DocumentJobRoles")
}

model DocumentAcknowledgement {
  id                String           @id @default(cuid())
  documentId        String
  employeeId        String
  acknowledgedAt    DateTime         @default(now())
  employmentCheckId String?
  document          Document         @relation(fields: [documentId], references: [id])
  employee          Employee         @relation(fields: [employeeId], references: [id])
  EmploymentCheck   EmploymentCheck? @relation(fields: [employmentCheckId], references: [id])

  @@unique([documentId, employeeId])
}

model EmploymentCheck {
  id                       String                    @id @default(cuid())
  employeeId               String
  typeOfCheck              String
  documentNumber           String
  dateOfIssue              DateTime
  expiryDate               DateTime
  documentUrl              String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  documentAcknowledgements DocumentAcknowledgement[]
  employee                 Employee                  @relation(fields: [employeeId], references: [id])
}

model DriverLicence {
  id            String    @id @default(cuid())
  employeeId    String
  type          String
  licenceNumber String
  issueDate     DateTime
  expiryDate    DateTime
  documentId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  document      Document? @relation(fields: [documentId], references: [id])
  employee      Employee  @relation(fields: [employeeId], references: [id])
}

model TrainingRecord {
  id            String           @id @default(cuid())
  employeeId    String
  dateCompleted DateTime
  expiryDate    DateTime?
  documentId    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  courseId      String
  providerId    String
  course        Course           @relation(fields: [courseId], references: [id])
  document      Document?        @relation(fields: [documentId], references: [id])
  employee      Employee         @relation(fields: [employeeId], references: [id])
  provider      TrainingProvider @relation(fields: [providerId], references: [id])
}

model ExpiryRule {
  id             String   @id @default(cuid())
  category       String   @unique
  daysBefore     Int
  notifyAdmin    Boolean  @default(true)
  notifyManager  Boolean  @default(true)
  notifyEmployee Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model NewsPost {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  content       Json
  authorId      String
  publishedAt   DateTime?
  pinned        Boolean   @default(false)
  tags          String[]
  audience      Json
  attachments   String[]
  videoEmbedUrl String?
  sendEmail     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  author        User      @relation(fields: [authorId], references: [id])
}

model Course {
  id              String           @id @default(cuid())
  name            String           @unique
  trainingRecords TrainingRecord[]
}

model TrainingProvider {
  id              String           @id @default(cuid())
  name            String           @unique
  trainingRecords TrainingRecord[]
}

model Location {
  id        String  @id @default(uuid())
  name      String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model OnboardingTemplate {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  isDefault             Boolean                @default(false)
  companyId             String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  updatedById           String?
  isActive              Boolean                @default(false)
  employees             Employee[]             @relation("OnboardingTemplateEmployees")
  onboardingAssignments OnboardingAssignment[]
  onboardingInstances   OnboardingInstance[]
  steps                 OnboardingStep[]
  company               Company                @relation(fields: [companyId], references: [id])
  departments           Department[]           @relation("OnboardingTemplateDepartments")
  jobRoles              JobRole[]              @relation("OnboardingTemplateJobRoles")
  updatedBy             User?                  @relation("OnboardingTemplateUpdatedBy", fields: [updatedById], references: [id])

  @@unique([companyId, name])
}

model OnboardingStep {
  id                      String                   @id @default(cuid())
  type                    OnboardingStepType
  label                   String
  order                   Int
  templateId              String
  documentId              String?
  uploadType              OnboardingUploadType?
  instruction             String?
  formId                  String? // <-- Already correctly defined
  // New fields for step library & SLAs (optional, backward compatible)
  taskOwnerId             String? // For CREATE_TASK type
  trainingId              String? // For TRAINING_ASSIGNMENT type  
  slaDays                 Int? // Due X days from start date
  dependencies            String[]                 @default([]) // Array of step IDs that must complete first
  metadata                Json? // Additional step-specific configuration
  document                Document?                @relation(fields: [documentId], references: [id])
  form                    Form?                    @relation(fields: [formId], references: [id])
  template                OnboardingTemplate       @relation(fields: [templateId], references: [id])
  onboardingStepInstances OnboardingStepInstance[]

  @@unique([templateId, label])
}

model OnboardingInstance {
  id          String                   @id @default(cuid())
  employeeId  String
  templateId  String
  startedAt   DateTime                 @default(now())
  completedAt DateTime?
  status      String                   @default("active")
  employee    Employee                 @relation(fields: [employeeId], references: [id])
  template    OnboardingTemplate       @relation(fields: [templateId], references: [id])
  steps       OnboardingStepInstance[]
}

model OnboardingStepInstance {
  id                   String                   @id @default(cuid())
  onboardingInstanceId String
  stepId               String
  status               String
  completedAt          DateTime?
  order                Int                      @default(0)
  onboardingInstance   OnboardingInstance       @relation(fields: [onboardingInstanceId], references: [id])
  step                 OnboardingStep           @relation(fields: [stepId], references: [id])
  responses            OnboardingStepResponse[]
}

model OnboardingStepResponse {
  id                       String                 @id @default(cuid())
  onboardingStepInstanceId String
  response                 Json
  createdAt                DateTime               @default(now())
  onboardingStepInstance   OnboardingStepInstance @relation(fields: [onboardingStepInstanceId], references: [id])
}

model OnboardingAssignment {
  id          String             @id @default(uuid())
  userId      String
  templateId  String
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  progress    Json?
  template    OnboardingTemplate @relation(fields: [templateId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
}

model Form {
  id                   String           @id @default(cuid())
  companyId            String
  name                 String
  slug                 String
  description          String?
  schema               Json
  formType             FormType         @default(SUBMISSION) // NEW: Form type
  version              Int              @default(1)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  visibleToDepartments String[]         @default([])
  visibleToJobRoles    String[]         @default([])
  visibleToRoles       String[]         @default([])
  company              Company          @relation(fields: [companyId], references: [id])
  assignments          FormAssignment[]
  submissions          FormSubmission[]
  dataRecords          FormDataRecord[] // NEW: Persistent data records
  onboardingSteps      OnboardingStep[]

  @@unique([companyId, slug])
  @@unique([companyId, name])
}

model FormAssignment {
  id           String    @id @default(cuid())
  formId       String
  employeeId   String
  assignedById String
  dueDate      DateTime?
  status       String    @default("pending")
  completedAt  DateTime?
  assignedBy   User      @relation("AssignedForms", fields: [assignedById], references: [id])
  employee     Employee  @relation(fields: [employeeId], references: [id])
  form         Form      @relation(fields: [formId], references: [id])
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  employeeId  String
  data        Json
  submittedAt DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id])
  form        Form     @relation(fields: [formId], references: [id])
}

model FormDataRecord {
  id         String   @id @default(cuid())
  formId     String
  employeeId String
  data       Json // Persistent data that can be updated
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])
  form       Form     @relation(fields: [formId], references: [id])

  @@unique([formId, employeeId]) // One data record per employee per form
}

model PermissionProfile {
  id          String           @id @default(cuid())
  companyId   String
  name        String
  description String?
  permissions Json // JSON object mapping screens to permission actions
  builtIn     Boolean          @default(false)
  // New scope and constraints - nullable for backward compatibility
  scope       PermissionScope?
  constraints Json? // { departmentIds?: string[], jobRoles?: string[] }
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company      Company                  @relation(fields: [companyId], references: [id])
  users        User[]
  oldAuditLogs PermissionAudit[]        @relation("PermissionAuditOldProfile")
  newAuditLogs PermissionAudit[]        @relation("PermissionAuditNewProfile")
  auditLogs    PermissionProfileAudit[]

  @@unique([companyId, name])
}

model PermissionAudit {
  id             String   @id @default(cuid())
  employeeId     String
  changedById    String
  oldProfileId   String?
  newProfileId   String?
  oldPermissions Json? // Snapshot of old profile permissions
  newPermissions Json? // Snapshot of new profile permissions
  note           String?
  changedAt      DateTime @default(now())

  employee   User               @relation("PermissionAuditEmployee", fields: [employeeId], references: [id])
  changedBy  User               @relation("PermissionAuditChangedBy", fields: [changedById], references: [id])
  oldProfile PermissionProfile? @relation("PermissionAuditOldProfile", fields: [oldProfileId], references: [id])
  newProfile PermissionProfile? @relation("PermissionAuditNewProfile", fields: [newProfileId], references: [id])

  @@index([employeeId])
  @@index([changedAt])
}

// Records field-level changes to a user's personal information
model PersonalInfoAudit {
  id            String   @id @default(cuid())
  companyId     String
  subjectUserId String
  changedById   String
  field         String
  oldValue      String?
  newValue      String?
  changedAt     DateTime @default(now())

  subjectUser User @relation("PersonalInfoAuditSubjectUser", fields: [subjectUserId], references: [id])
  changedBy   User @relation("PersonalInfoAuditChangedBy", fields: [changedById], references: [id])

  @@index([companyId, subjectUserId, changedAt])
}

// New Permission Profile Audit table
model PermissionProfileAudit {
  id        String   @id @default(cuid())
  profileId String
  action    String // "created", "updated", "deleted"
  changes   Json? // Detailed change log
  changedBy String
  changedAt DateTime @default(now())

  profile PermissionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([changedAt])
}

model GenderOption {
  id        String   @id @default(cuid())
  companyId String
  key       String
  label     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  users   User[]

  @@unique([companyId, key])
  @@index([companyId, active])
}

