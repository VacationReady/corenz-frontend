model TemplateStepVersion {
  id                        String                @id @default(cuid())
  templateVersionId         String
  stepId                    String
  companyId                 String
  version                   Int
  type                      OnboardingStepType
  label                     String
  order                     Int
  documentId                String?
  uploadType                OnboardingUploadType?
  instruction               String?
  formId                    String?
  dependencies              String[]              @default([])
  metadata                  Json?
  slaDays                   Int?
  taskOwnerId               String?
  trainingId                String?
